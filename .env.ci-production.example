# .env.ci-production: Production's CI secrets (mm-ci-production), for scripts/verify-ci-token.ts production.
# Copy to .env.ci-production (git ignores it) and fill in the values; docs/env-files.md says where each comes from.
# Never commit a value, and never print one.
CLOUDFLARE_API_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
