# .env.production-access: A Cloudflare Access service token for production's hosts behind Access, for the smoke and erasure scripts.
# Copy to .env.production-access (git ignores it) and fill in the values; docs/env-files.md says where each comes from.
# Never commit a value, and never print one.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
PRODUCTION_TEST_MOBILE=
ERASURE_SECRET=
