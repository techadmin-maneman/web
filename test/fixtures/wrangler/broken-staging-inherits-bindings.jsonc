// DELIBERATELY BROKEN. CI runs the config check on this file and requires it
// to fail. It is wrangler.jsonc with one mistake: staging does not redeclare
// its queues, so staging would run without them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mm-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maneman-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "mm-local-tryon-uploads"
    },
    {
      "binding": "RESULTS",
      "bucket_name": "mm-local-tryon-results"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RENDER_QUEUE",
        "queue": "mm-render-local"
      },
      {
        "binding": "CRM_QUEUE",
        "queue": "mm-crm-sync-local"
      },
      {
        "binding": "MESSAGE_QUEUE",
        "queue": "mm-messaging-local"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "IMAGE_PROVIDER": "stub",
    "CRM_PROVIDER": "stub",
    "MESSAGING_PROVIDER": "stub"
  },
  "env": {
    "staging": {
      "name": "mm-api-staging",
      "account_id": "a2e185075b1b8eef3bee24b72f45ace3",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false }
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "routes": [
        {
          "pattern": "staging.maneman.in/api/*",
          "zone_name": "maneman.in"
        },
        {
          "pattern": "app-staging.maneman.in/api/*",
          "zone_name": "maneman.in"
        },
        {
          "pattern": "ops-staging.maneman.in/api/*",
          "zone_name": "maneman.in"
        },
        {
          "pattern": "tech-staging.maneman.in/api/*",
          "zone_name": "maneman.in"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "maneman-staging",
          "database_id": "82a07dc1-c86e-4905-b9ac-a474652a1d63",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "mm-staging-tryon-uploads"
        },
        {
          "binding": "RESULTS",
          "bucket_name": "mm-staging-tryon-results"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "IMAGE_PROVIDER": "ailabtools",
        "CRM_PROVIDER": "zoho",
        "MESSAGING_PROVIDER": "bsp"
      }
    },
    "production": {
      "name": "mm-api-production",
      "account_id": "a2e185075b1b8eef3bee24b72f45ace3",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false }
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "routes": [
        {
          "pattern": "maneman.in/api/*",
          "zone_name": "maneman.in"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "maneman-prod",
          "database_id": "4917e9e0-7bf4-4116-9894-369d490f0ea2",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "mm-prod-tryon-uploads"
        },
        {
          "binding": "RESULTS",
          "bucket_name": "mm-prod-tryon-results"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "RENDER_QUEUE",
            "queue": "mm-render-prod"
          },
          {
            "binding": "CRM_QUEUE",
            "queue": "mm-crm-sync-prod"
          },
          {
            "binding": "MESSAGE_QUEUE",
            "queue": "mm-messaging-prod"
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "IMAGE_PROVIDER": "ailabtools",
        "CRM_PROVIDER": "zoho",
        "MESSAGING_PROVIDER": "bsp"
      }
    }
  }
}
