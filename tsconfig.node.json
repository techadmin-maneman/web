{
  // Build, check and smoke scripts, and the tests that run in Node. Node runs
  // these .ts files directly (type stripping), hence erasableSyntaxOnly and
  // explicit .ts import extensions.
  //
  // Workers types are included because scripts/generate-openapi.ts imports the
  // Worker's route modules to read their zod schemas.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "scripts/**/*.ts",
    "test/node/**/*.ts",
    "packages/brand/*.ts",
    "packages/web-kit/*.ts",
    "apps/app/headers.ts",
    "apps/app/pwa.ts",
    "apps/ops/headers.ts",
    "apps/tech/headers.ts",
    "apps/tech/pwa.ts",
    "src/config/**/*.ts",
    "src/worker-configuration.d.ts",
    "vitest.config.ts",
    "test/stalled-files.ts",
    "eslint.config.ts"
  ],
  // Browser-side tooling has its own config, tsconfig.browser.json, and so does
  // every test in test/node/dom/: they run in Node but import the apps' code,
  // written against the DOM. A new test of an app's code goes in that folder.
  "exclude": [
    // A service worker's own code, checked with its WebWorker types by apps/*/sw/tsconfig.json.
    "packages/web-kit/sw-shell.ts",
    "test/node/dom/**",
    "packages/web-kit/api.ts",
    "packages/web-kit/client-errors.ts",
    "packages/web-kit/small-jpeg.ts",
    "packages/web-kit/turnstile.ts",
    "scripts/seed-local.ts",
    "scripts/fidelity*.ts",
    "scripts/lib/fidelity.ts",
    "scripts/serve-*.ts",
    "scripts/lighthouse.ts",
    "scripts/lib/static-server.ts",
    "scripts/smoke-csp.ts",
    "scripts/lib/csp-refusals.ts"
  ]
}
