{
  // Build, check and smoke scripts, and the tests that run in Node. Node runs
  // these .ts files directly (type stripping), hence erasableSyntaxOnly and
  // explicit .ts import extensions.
  //
  // Workers types are included because scripts/generate-openapi.ts imports the
  // Worker's route modules to read their zod schemas.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "scripts/**/*.ts",
    "test/node/**/*.ts",
    "packages/brand/*.ts",
    "packages/web-kit/*.ts",
    "apps/app/headers.ts",
    "apps/app/pwa.ts",
    "apps/ops/headers.ts",
    "apps/tech/headers.ts",
    "apps/tech/sw-build.ts",
    "src/config/**/*.ts",
    "src/worker-configuration.d.ts",
    "vitest.config.ts",
    "test/stalled-files.ts",
    "eslint.config.ts"
  ],
  // Browser-side tooling has its own config: tsconfig.browser.json, as do the
  // technician app's store tests, which run in Node on a fake IndexedDB but
  // import code written against the DOM.
  "exclude": [
    "test/node/app-api.test.ts",
    "test/node/app-checkout.test.ts",
    "test/node/app-consent-lines.test.ts",
    "test/node/app-documents.test.ts",
    "test/node/app-invite-share.test.ts",
    "test/node/fakes-contract.test.ts",
    "test/node/app-payments.test.ts",
    "test/node/app-money.test.ts",
    "test/node/app-next-visit-words.test.ts",
    "test/node/app-referral-card.test.ts",
    "test/node/app-route.test.ts",
    "test/node/ops-board-budget.test.ts",
    "test/node/ops-dispatch-job.test.ts",
    "test/node/ops-route.test.ts",
    "test/node/ops-staff-grants.test.ts",
    "test/node/ops-waiting.test.ts",
    "test/node/tech-api.test.ts",
    "test/node/tech-content.test.ts",
    "test/node/tech-kept.test.ts",
    "test/node/tech-outbox.test.ts",
    "test/node/tech-outbox-replay.test.ts",
    "test/node/tech-piece-label.test.ts",
    "test/node/tech-profile-form.test.ts",
    "test/node/tech-progress.test.ts",
    "test/node/tech-set-aside.test.ts",
    "test/node/tech-store.test.ts",
    "test/node/ui-*.test.ts",
    "test/node/web-kit-api.test.ts",
    "packages/web-kit/api.ts",
    "packages/web-kit/small-jpeg.ts",
    "test/node/static-server.test.ts",
    "scripts/seed-local.ts",
    "scripts/fidelity.ts",
    "scripts/fidelity-app.ts",
    "scripts/fidelity-ops.ts",
    "scripts/fidelity-refer.ts",
    "scripts/fidelity-tech.ts",
    "scripts/lib/fidelity.ts",
    "scripts/serve-site.ts",
    "scripts/serve-app.ts",
    "scripts/serve-ops.ts",
    "scripts/serve-tech.ts",
    "scripts/lighthouse.ts",
    "scripts/lib/static-server.ts",
    "scripts/smoke-csp.ts",
    "scripts/lib/csp-refusals.ts"
  ]
}
