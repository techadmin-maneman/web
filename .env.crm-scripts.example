# .env.crm-scripts: Zoho CRM with the scripts' own refresh token, never the Worker's, for the CRM's scripts and probes.
# Copy to .env.crm-scripts (git ignores it) and fill in the values; docs/env-files.md says where each comes from.
# Never commit a value, and never print one.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_SCRIPTS_REFRESH_TOKEN=
ZOHO_ACCOUNTS_HOST=
ZOHO_API_HOST=
