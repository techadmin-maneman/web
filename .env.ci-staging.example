# .env.ci-staging: Staging's CI secrets, as GitHub holds them, for scripts/verify-ci-token.ts staging.
# Copy to .env.ci-staging (git ignores it) and fill in the values; docs/env-files.md says where each comes from.
# Never commit a value, and never print one.
CLOUDFLARE_API_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
