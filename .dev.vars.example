# Local secrets for wrangler dev and the types generator. Copy to .dev.vars
# (git ignores it). Nothing here is real: the Turnstile value is Cloudflare's
# always-pass test secret, and local runs use stub providers, so the Zoho and
# alert values stay empty. Staging and production get theirs from
# `wrangler secret put` (docs/runbook.md).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
IP_HASH_SALT=local-development-salt-not-a-real-secret
ALERT_WEBHOOK_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_HOST=
ZOHO_API_HOST=
ZOHO_LAR_ID=
