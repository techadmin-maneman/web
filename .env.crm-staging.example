# .env.crm-staging: Zoho CRM as staging's Worker reaches it, for scripts/setup-crm.ts.
# Copy to .env.crm-staging (git ignores it) and fill in the values; docs/env-files.md says where each comes from.
# Never commit a value, and never print one.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_HOST=
ZOHO_API_HOST=
ZOHO_LAR_ID=
