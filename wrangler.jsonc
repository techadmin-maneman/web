// mm-api: serves https://{host}/api/* and owns every binding and secret.
//
// The top level is the local environment (`wrangler dev`, tests). Staging and
// production each redeclare everything; `npm run check:config` fails if one
// does not. See docs/decisions/0005-environment-isolation-in-wrangler-config.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mm-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maneman-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "mm-local-tryon-uploads" },
    { "binding": "RESULTS", "bucket_name": "mm-local-tryon-results" },
    // Clients' photographs: no lifecycle rule, deleted only on purpose (docs/decisions/0032-fsm-mirror.md).
    { "binding": "CLIENT_PHOTOS", "bucket_name": "mm-local-client-photos" },
    // Referral cards a client made; a revoke deletes them (docs/decisions/0048-referrals.md).
    { "binding": "REFERRAL_CARDS", "bucket_name": "mm-local-referral-cards" }
  ],
  "queues": {
    "producers": [
      { "binding": "RENDER_QUEUE", "queue": "mm-render-local" },
      { "binding": "CRM_QUEUE", "queue": "mm-crm-sync-local" },
      { "binding": "MESSAGE_QUEUE", "queue": "mm-messaging-local" },
      { "binding": "FSM_QUEUE", "queue": "mm-fsm-sync-local" }
    ],
    // crm-sync asks for one batch at a time; Queues does not guarantee it (docs/decisions/0012-zoho-sync.md).
    "consumers": [
      {
        "queue": "mm-crm-sync-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "max_concurrency": 1
      },
      {
        "queue": "mm-render-local",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        // Polling a render is a delayed retry: the 15 minutes it is followed for (RENDER_GIVE_UP_MS,
        // src/config/pipeline.ts) take about 33 polls, so 100 leaves room to spare.
        "max_retries": 100
      },
      {
        "queue": "mm-messaging-local",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1
      },
      // FSM hints: each names an appointment to read afresh (docs/decisions/0032-fsm-mirror.md).
      {
        "queue": "mm-fsm-sync-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "TURNSTILE_ACCEPT_TEST_TOKEN": "true",
    "IMAGE_PROVIDER": "stub",
    "CRM_PROVIDER": "stub",
    "MESSAGING_PROVIDER": "stub",
    "ACCESS_PROVIDER": "stub",
    "ACCESS_TEAM_DOMAIN": "summer-math-0275.cloudflareaccess.com",
    // The stub needs no audience.
    "ACCESS_OPS_AUD": "",
    "SMS_PROVIDER": "stub",
    // Zoho FSM is off: our own database is the record of field work. The Books stub reaches nothing.
    "FSM_PROVIDER": "none",
    "BOOKS_PROVIDER": "stub",
    "ZOHO_FSM_ACCOUNTS_HOST": "",
    "ZOHO_FSM_API_HOST": "",
    "ZOHO_BOOKS_ACCOUNTS_HOST": "",
    "ZOHO_BOOKS_API_HOST": "",
    "ZOHO_BOOKS_ORG_ID": "",
    "BOOKS_REFUND_ACCOUNT_ID": "",
    // GST in Books, empty until the CA gives the GSTIN, the state it is registered in and the SAC code.
    "BOOKS_GSTIN": "",
    "BOOKS_GST_STATE": "",
    "BOOKS_SAC": "",
    // Razorpay (docs/decisions/0044-payments-mirror.md). The stub takes no money and reaches nothing.
    "PAYMENTS_PROVIDER": "stub",
    "GEOCODE_PROVIDER": "stub",
    "SELF_SERVE_BOOKING": "true",
    "REFERRER_NAME_ON_INVITE": "true",
    "RAZORPAY_KEY_ID": "",
    // Daily ceilings; test/node/free-tier-budget.test.ts proves they fit the free tier.
    "RENDER_DAILY_CEILING": "20",
    "UPLOAD_DAILY_CEILING": "40",
    "RESULT_READ_DAILY_CEILING": "400",
    // Google requests a day, across every client. It refuses rather than spends
    // (docs/decisions/0054-address-capture.md); at most GEOCODE_CEILING_MAX.
    "GEOCODE_DAILY_CEILING": "200",
    "RESULT_RETENTION_DAYS": "3",
    "AILAB_CREDIT_FLOOR": "200",
    "MESSAGING_ENABLED": "true"
  },
  "env": {
    "staging": {
      "name": "mm-api-staging",
      "account_id": "a2e185075b1b8eef3bee24b72f45ace3",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "triggers": { "crons": ["*/5 * * * *"] },
      // One per switched-on surface (docs/decisions/0026-hosts-and-surfaces.md).
      "routes": [
        { "pattern": "staging.maneman.in/api/*", "zone_name": "maneman.in" },
        { "pattern": "app-staging.maneman.in/api/*", "zone_name": "maneman.in" },
        { "pattern": "ops-staging.maneman.in/api/*", "zone_name": "maneman.in" },
        { "pattern": "tech-staging.maneman.in/api/*", "zone_name": "maneman.in" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "maneman-staging",
          "database_id": "82a07dc1-c86e-4905-b9ac-a474652a1d63",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "mm-staging-tryon-uploads" },
        { "binding": "RESULTS", "bucket_name": "mm-staging-tryon-results" },
        // Clients' photographs: no lifecycle rule, deleted only on purpose (docs/decisions/0032-fsm-mirror.md).
        { "binding": "CLIENT_PHOTOS", "bucket_name": "mm-staging-client-photos" },
        // Referral cards a client made; a revoke deletes them (docs/decisions/0048-referrals.md).
        { "binding": "REFERRAL_CARDS", "bucket_name": "mm-staging-referral-cards" }
      ],
      "queues": {
        "producers": [
          { "binding": "RENDER_QUEUE", "queue": "mm-render-staging" },
          { "binding": "CRM_QUEUE", "queue": "mm-crm-sync-staging" },
          { "binding": "MESSAGE_QUEUE", "queue": "mm-messaging-staging" },
          { "binding": "FSM_QUEUE", "queue": "mm-fsm-sync-staging" }
        ],
        "consumers": [
          {
            "queue": "mm-crm-sync-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 2,
            "max_concurrency": 1
          },
          {
            "queue": "mm-render-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            // Polling a render is a delayed retry: the 15 minutes it is followed for (RENDER_GIVE_UP_MS,
            // src/config/pipeline.ts) take about 33 polls, so 100 leaves room to spare.
            "max_retries": 100
          },
          {
            "queue": "mm-messaging-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "max_concurrency": 1
          },
          // FSM hints: each names an appointment to read afresh (docs/decisions/0032-fsm-mirror.md).
          {
            "queue": "mm-fsm-sync-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "max_concurrency": 1
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "TURNSTILE_ACCEPT_TEST_TOKEN": "true",
        "IMAGE_PROVIDER": "ailabtools",
        "CRM_PROVIDER": "zoho",
        "MESSAGING_PROVIDER": "evolution",
        "ACCESS_PROVIDER": "cloudflare",
        "ACCESS_TEAM_DOMAIN": "summer-math-0275.cloudflareaccess.com",
        // The ops-staging Access application's audience tag.
        "ACCESS_OPS_AUD": "c291b99aae607b12ae256176566169e7a50dcfa839ef0834ad807563353dcee4",
        "SMS_PROVIDER": "none",
        // Zoho FSM is off: our own database is the record of field work (docs/runbook.md, "Switching staging off FSM").
        // Books is in the real org (ADR 0025, item 26). Secrets ZOHO_BOOKS_CLIENT_ID, _SECRET and _REFRESH_TOKEN: the
        // org's one Self Client, with a refresh token of Books' own. FSM's secrets may stay set; nothing reads them.
        "FSM_PROVIDER": "none",
        "BOOKS_PROVIDER": "zoho",
        "ZOHO_FSM_ACCOUNTS_HOST": "accounts.zoho.in",
        "ZOHO_FSM_API_HOST": "www.zohoapis.in",
        "ZOHO_BOOKS_ACCOUNTS_HOST": "accounts.zoho.in",
        "ZOHO_BOOKS_API_HOST": "www.zohoapis.in",
        "ZOHO_BOOKS_ORG_ID": "60088931635",
        "BOOKS_REFUND_ACCOUNT_ID": "4242595000000038161",
        // GST in Books, empty until the CA gives the GSTIN, the state it is registered in and the SAC code.
        "BOOKS_GSTIN": "",
        "BOOKS_GST_STATE": "",
        "BOOKS_SAC": "",
        // Razorpay in test mode: no real money. The key secret and the webhook secret are secrets.
        "PAYMENTS_PROVIDER": "razorpay",
        // The owner's key is in place (docs/runbook.md, section 13); production waits for the release.
        "GEOCODE_PROVIDER": "google",
        "SELF_SERVE_BOOKING": "true",
        "REFERRER_NAME_ON_INVITE": "true",
        "RAZORPAY_KEY_ID": "rzp_test_Tf1Bf3ElRK6uNQ",
        // Daily ceilings; test/node/free-tier-budget.test.ts proves they fit the free tier.
        "RENDER_DAILY_CEILING": "20",
        "UPLOAD_DAILY_CEILING": "40",
        "RESULT_READ_DAILY_CEILING": "400",
        // Google requests a day, across every client. It refuses rather than spends
        // (docs/decisions/0054-address-capture.md); at most GEOCODE_CEILING_MAX.
        "GEOCODE_DAILY_CEILING": "200",
        "RESULT_RETENTION_DAYS": "3",
        "AILAB_CREDIT_FLOOR": "200",
        "MESSAGING_ENABLED": "true"
      }
    },
    "production": {
      "name": "mm-api-production",
      "account_id": "a2e185075b1b8eef3bee24b72f45ace3",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "triggers": { "crons": ["*/5 * * * *"] },
      "routes": [{ "pattern": "maneman.in/api/*", "zone_name": "maneman.in" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "maneman-prod",
          "database_id": "4917e9e0-7bf4-4116-9894-369d490f0ea2",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "mm-prod-tryon-uploads" },
        { "binding": "RESULTS", "bucket_name": "mm-prod-tryon-results" },
        // Clients' photographs: no lifecycle rule, deleted only on purpose (docs/decisions/0032-fsm-mirror.md).
        { "binding": "CLIENT_PHOTOS", "bucket_name": "mm-prod-client-photos" },
        // Referral cards a client made; a revoke deletes them (docs/decisions/0048-referrals.md).
        { "binding": "REFERRAL_CARDS", "bucket_name": "mm-prod-referral-cards" }
      ],
      "queues": {
        "producers": [
          { "binding": "RENDER_QUEUE", "queue": "mm-render-prod" },
          { "binding": "CRM_QUEUE", "queue": "mm-crm-sync-prod" },
          { "binding": "MESSAGE_QUEUE", "queue": "mm-messaging-prod" },
          { "binding": "FSM_QUEUE", "queue": "mm-fsm-sync-prod" }
        ],
        "consumers": [
          {
            "queue": "mm-crm-sync-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 2,
            "max_concurrency": 1
          },
          {
            "queue": "mm-render-prod",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            // Polling a render is a delayed retry: the 15 minutes it is followed for (RENDER_GIVE_UP_MS,
            // src/config/pipeline.ts) take about 33 polls, so 100 leaves room to spare.
            "max_retries": 100
          },
          {
            "queue": "mm-messaging-prod",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "max_concurrency": 1
          },
          // FSM hints: each names an appointment to read afresh (docs/decisions/0032-fsm-mirror.md).
          {
            "queue": "mm-fsm-sync-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "max_concurrency": 1
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "TURNSTILE_ACCEPT_TEST_TOKEN": "false",
        "IMAGE_PROVIDER": "ailabtools",
        "CRM_PROVIDER": "zoho",
        "MESSAGING_PROVIDER": "evolution",
        "ACCESS_PROVIDER": "cloudflare",
        "ACCESS_TEAM_DOMAIN": "summer-math-0275.cloudflareaccess.com",
        // The ops Access application's audience tag; unused until ops is switched on in production.
        "ACCESS_OPS_AUD": "aeb0323bfcacdaac2935265df92982ac031e2175fa6b111878d11dabd6de3773",
        "SMS_PROVIDER": "none",
        // Zoho FSM and Books stay off until Phase 2's release (docs/open-points.md).
        "FSM_PROVIDER": "none",
        "BOOKS_PROVIDER": "none",
        "ZOHO_FSM_ACCOUNTS_HOST": "",
        "ZOHO_FSM_API_HOST": "",
        "ZOHO_BOOKS_ACCOUNTS_HOST": "",
        "ZOHO_BOOKS_API_HOST": "",
        "ZOHO_BOOKS_ORG_ID": "",
        "BOOKS_REFUND_ACCOUNT_ID": "",
        // GST in Books, empty until the CA gives the GSTIN, the state it is registered in and the SAC code.
        "BOOKS_GSTIN": "",
        "BOOKS_GST_STATE": "",
        "BOOKS_SAC": "",
        // Razorpay stays off until Phase 2's release (docs/open-points.md, item 6).
        "PAYMENTS_PROVIDER": "none",
        "GEOCODE_PROVIDER": "none",
        "SELF_SERVE_BOOKING": "false",
        "REFERRER_NAME_ON_INVITE": "true",
        "RAZORPAY_KEY_ID": "",
        // Daily ceilings; test/node/free-tier-budget.test.ts proves they fit the free tier.
        "RENDER_DAILY_CEILING": "40",
        "UPLOAD_DAILY_CEILING": "80",
        "RESULT_READ_DAILY_CEILING": "800",
        // Google requests a day, across every client. It refuses rather than spends
        // (docs/decisions/0054-address-capture.md); at most GEOCODE_CEILING_MAX.
        "GEOCODE_DAILY_CEILING": "200",
        // Fourteen days, not thirty, to leave R2 room for Phase 2's photographs (docs/decisions/0039-phase-2-budget.md).
        "RESULT_RETENTION_DAYS": "14",
        "AILAB_CREDIT_FLOOR": "200",
        "MESSAGING_ENABLED": "false"
      }
    }
  }
}
