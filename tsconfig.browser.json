{
  // The browser tests (e2e/) and the fidelity harness: Node code whose callbacks
  // run in a page, so they need the DOM's types, which clash with the Workers
  // types in tsconfig.node.json. The technician app's store tests are here for
  // the same reason: they run in Node, on a fake IndexedDB, against DOM code.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts",
    "test/node/tech-api.test.ts",
    "test/node/tech-kept.test.ts",
    "test/node/tech-outbox-replay.test.ts",
    "test/node/tech-store.test.ts",
    "playwright.config.ts",
    "playwright.staging.config.ts",
    "scripts/fidelity.ts",
    "scripts/fidelity-app.ts",
    "scripts/fidelity-ops.ts",
    "scripts/fidelity-refer.ts",
    "scripts/fidelity-tech.ts",
    "scripts/lib/fidelity.ts",
    "scripts/serve-site.ts",
    "scripts/serve-app.ts",
    "scripts/serve-ops.ts",
    "scripts/serve-tech.ts",
    "scripts/lighthouse.ts",
    "scripts/lib/static-server.ts"
  ]
}
