{
  // The browser tests (e2e/) and the fidelity harness: Node code whose callbacks
  // run in a page, so they need the DOM's types, which clash with the Workers
  // types in tsconfig.node.json. Every test in test/node/dom/ is here for the
  // same reason: it runs in Node against the apps' code, written against the
  // DOM; and so are the tests of the apps' components on a page (test/dom).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "e2e/**/*.ts",
    "test/dom/**/*.ts",
    "test/node/dom/**/*.ts",
    // What each app is built for, which the apps' code these tests import reads.
    "apps/*/src/env.d.ts",
    "packages/web-kit/access.ts",
    "packages/web-kit/api.ts",
    "packages/web-kit/client-errors.ts",
    "packages/web-kit/small-jpeg.ts",
    "packages/web-kit/turnstile.ts",
    "playwright.config.ts",
    "playwright.staging.config.ts",
    "scripts/dev/seed-local.ts",
    "scripts/fidelity/*.ts",
    "scripts/lib/fidelity.ts",
    "scripts/dev/serve-*.ts",
    "scripts/ci/lighthouse.ts",
    "scripts/lib/static-server.ts",
    "scripts/release/smoke-csp.ts",
    "scripts/lib/csp-refusals.ts"
  ]
}
