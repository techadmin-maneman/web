{
  "name": "maneman-web",
  "private": true,
  "description": "Mane Man web: the mm-api Worker, the mm-site public site, and the Phase 2 surfaces, with migrations and pipeline.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "gen": "npm run types && npm run openapi && npm run schema && npm run adr-index",
    "texts:export": "node scripts/export-texts.ts",
    "dev": "node scripts/dev-api.ts",
    "dev:all": "node scripts/dev-all.ts",
    "dev:site": "node scripts/build-site.ts --dev",
    "db:local": "wrangler d1 migrations apply DB --local && node scripts/mark-database.ts local",
    "db:seed:local": "node scripts/seed-local.ts",
    "tick": "node scripts/local.ts tick",
    "pay:local": "node scripts/local.ts pay",
    "close:local": "node scripts/local.ts close",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p apps/app/tsconfig.json && tsc --noEmit -p apps/app/sw/tsconfig.json && tsc --noEmit -p apps/ops/tsconfig.json && tsc --noEmit -p apps/tech/tsconfig.json && tsc --noEmit -p apps/tech/sw/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p site/tsconfig.worker.json && npm run check:site",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "node scripts/audit.ts",
    "verify": "npm run check:types && npm run typecheck && npm run lint && npm run format:check && npm run check:config && npm run check:migrations && npm run check:open-points && npm run check:dead && npm test && npm run build",
    "check:config": "node scripts/check-wrangler-config.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "check:open-points": "node scripts/check-open-points.ts",
    "check:dead": "knip --workspace . --no-progress",
    "check:types": "wrangler types src/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example --check",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "build": "node scripts/build.ts",
    "adr-index": "node scripts/generate-adr-index.ts",
    "schema": "node scripts/generate-schema-doc.ts",
    "openapi": "node scripts/generate-openapi.ts && openapi-typescript docs/openapi.json --output site/src/lib/api-schema.ts && openapi-typescript docs/openapi-client.json --output apps/app/src/api-schema.ts && openapi-typescript docs/openapi-ops.json --output apps/ops/src/api-schema.ts && openapi-typescript docs/openapi-tech.json --output apps/tech/src/api-schema.ts",
    "smoke": "node scripts/smoke.ts",
    "smoke:csp": "node scripts/smoke-csp.ts",
    "apply-triggers": "node scripts/apply-triggers.ts",
    "check:triggers": "node scripts/check-triggers.ts",
    "check:buckets": "node scripts/check-buckets.ts",
    "build:site": "node scripts/build-site.ts",
    "build:app": "node scripts/build-app.ts",
    "build:ops": "node scripts/build-ops.ts",
    "build:tech": "node scripts/build-tech.ts",
    "dev:app": "node node_modules/vite/bin/vite.js --config apps/app/vite.config.ts",
    "dev:ops": "node node_modules/vite/bin/vite.js --config apps/ops/vite.config.ts",
    "dev:tech": "node node_modules/vite/bin/vite.js --config apps/tech/vite.config.ts",
    "check:site": "node scripts/build-site.ts --check",
    "fidelity": "node scripts/fidelity.ts",
    "fidelity:refer": "node scripts/fidelity-refer.ts",
    "fidelity:app": "node scripts/fidelity-app.ts",
    "fidelity:ops": "node scripts/fidelity-ops.ts",
    "fidelity:tech": "node scripts/fidelity-tech.ts",
    "test:e2e": "playwright test --project=390 --project=1440 --project=app --project=ops --project=tech --project=tech-ios",
    "test:tech-ios": "playwright test --project=tech-ios",
    "test:tech-staging": "playwright test --config playwright.staging.config.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "fonts": "node scripts/subset-fonts.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/preact": "6.0.5",
    "@axe-core/playwright": "4.13.0",
    "@babel/standalone": "7.29.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-istanbul": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.3",
    "docx": "9.8.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "jsonc-parser": "3.3.1",
    "knip": "5.88.1",
    "lighthouse": "13.5.0",
    "openapi-typescript": "7.13.0",
    "preact": "10.29.8",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.4",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "miniflare": {
      "undici": "7.29.1"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260918.1": true
  }
}
