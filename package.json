{
  "name": "maneman-web",
  "private": true,
  "description": "Mane Man Phase 1 backend: the mm-api Worker, the mm-site placeholder, migrations and pipeline.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev-vars.ts && npm run db:local && wrangler dev --env=\"\" --port 8787 --inspector-port 9230",
    "dev:site": "node scripts/build-site.ts --dev",
    "db:local": "wrangler d1 migrations apply DB --local && node scripts/mark-database.ts local",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.browser.json && npm run check:site",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:config": "node scripts/check-wrangler-config.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "build": "node scripts/build.ts",
    "openapi": "node scripts/generate-openapi.ts",
    "smoke": "node scripts/smoke.ts",
    "types:check": "wrangler types src/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example --check",
    "apply-triggers": "wrangler triggers deploy",
    "build:site": "node scripts/build-site.ts",
    "check:site": "node scripts/build-site.ts --check",
    "fidelity": "node scripts/fidelity.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/preact": "6.0.5",
    "@babel/standalone": "7.29.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "@eslint/js": "10.0.1",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-istanbul": "4.1.11",
    "astro": "7.3.3",
    "eslint": "10.11.0",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "preact": "10.29.8",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260918.1": true
  }
}
