---
// Every page's frame: the head, the fixed header and, on the home page only,
// the footer and the sticky bottom bar (as v2 shows them). The head carries
// what search engines and shared links read: the canonical address on
// production's host, Open Graph and X cards, and any structured data.
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sprite from "../components/Sprite.astro";
import StickyBar from "../components/StickyBar.astro";
import { business } from "../content/site.ts";
import { ENVIRONMENT, IS_PRODUCTION } from "../lib/build.ts";
import { FAVICON_SIZES, OG_IMAGE, token } from "../lib/brand-images.ts";
import { SITE_ORIGIN } from "../lib/site-origin.ts";
import { jsonLd } from "../lib/structured-data.ts";
import serif400 from "../../../node_modules/@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url";
import sans400 from "../../../node_modules/@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url";
import sans500 from "../../../node_modules/@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** The home page carries the footer and the sticky bar. */
  home?: boolean;
  /** Pages that should never be indexed, such as the 404. */
  noindex?: boolean;
  /** Schema.org objects, written as JSON-LD. Each is named, so the mm-site Worker can build it again. */
  structuredData?: readonly { readonly name: string; readonly data: object }[];
  /**
   * The card a shared link shows, at OG_IMAGE's size: the site's own unless a page has another. Its type and its
   * HTTPS address go beside it, which a chat's crawler may look for before it fetches the card.
   */
  image?: { readonly path: string; readonly type: string };
}

const {
  title,
  description,
  home = false,
  noindex = false,
  structuredData = [],
  image = { path: "/og.png", type: "image/png" },
} = Astro.props;
// /try is built as try.html; its address has no extension.
const path = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1");
const canonical = new URL(path, SITE_ORIGIN).href;
const ogImage = new URL(image.path, SITE_ORIGIN).href;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="mm-worker" content="mm-site" />
    <meta name="mm-environment" content={ENVIRONMENT} />
    {(!IS_PRODUCTION || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {description !== undefined && <meta name="description" content={description} />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={token("--ink")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    {description !== undefined && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={image.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={business.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {FAVICON_SIZES.map((size) => (
      <link
        rel="icon"
        type="image/png"
        sizes={`${String(size)}x${String(size)}`}
        href={`/favicon-${String(size)}.png`}
      />
    ))}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={serif400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans500} as="font" type="font/woff2" crossorigin />
    {structuredData.map((block) => (
      <script type="application/ld+json" data-structured={block.name} set:html={jsonLd(block.data)}></script>
    ))}
    <slot name="head" />
  </head>
  <body>
    <Sprite />
    <Header />
    <main>
      <slot />
    </main>
    {home && <Footer />}
    {home && <StickyBar />}
    <script>
      // Where this visit came from, kept for the booking or the try-on to send,
      // read before the analytics tags tidy the address.
      import { startAnalytics } from "../lib/analytics.ts";
      import { captureAttribution } from "../lib/visit.ts";
      captureAttribution();
      startAnalytics();
    </script>
  </body>
</html>
