---
// A long-form page of text in the site layout: the design's "Placeholder" tag while its wording waits, the way back to
// the list it belongs to, the title and its lead, then the page's own sections. The guides, the cities, the policies
// and the notices are drawn in it.
import { capsLook } from "@maneman/ui/Caps";
import { textLinkLook } from "@maneman/ui/TextLink";
import Icon from "../components/Icon.astro";
import { placeholderTag } from "../content/site.ts";
import { SHOW_PLACEHOLDER_TAGS } from "../lib/build.ts";
import Site from "./Site.astro";

interface Props {
  pageTitle: string;
  description: string;
  title: string;
  /** The sentence beneath the title; a page whose lead the Worker writes into draws its own in the "lead" slot. */
  lead?: string;
  /** Its wording is approved; until then, outside production, the page is tagged. */
  publish: boolean;
  /** Above the title, the list the page is one of: "All guides". */
  back?: { href: string; label: string };
  /** A short page, the cities', in the narrower column. */
  short?: boolean;
  /** Schema.org objects for the page, as the site layout writes them. */
  structuredData?: readonly object[];
  ogType?: "website" | "article";
}

const {
  pageTitle,
  description,
  title,
  lead,
  publish,
  back,
  short = false,
  structuredData = [],
  ogType = "website",
} = Astro.props;
---

<Site title={pageTitle} description={description} structuredData={structuredData} ogType={ogType}>
  <article class:list={["text-page", short && "short"]}>
    {SHOW_PLACEHOLDER_TAGS && !publish && <div class={capsLook("label tag")}>{placeholderTag}</div>}
    {back !== undefined && (
      <a class={textLinkLook({ tone: "strong", quiet: true, className: "back" })} href={back.href}>
        <Icon name="back" size="sm" />
        {back.label}
      </a>
    )}
    <h1 class="page-title">{title}</h1>
    <slot name="lead">{lead !== undefined && <p class="page-lede">{lead}</p>}</slot>
    <slot />
  </article>
</Site>

<style>
  .text-page {
    font-size: var(--site-fs-article);
    line-height: var(--lh-155);
  }
  .tag {
    display: inline-block;
    margin-bottom: var(--sp-12);
  }
  /* A thumb's height to tap, its words where the boards draw their line, 24 px tall. */
  .back {
    display: flex;
    width: fit-content;
    gap: var(--sp-4);
    margin: calc((var(--sp-24) - var(--tap)) / 2) 0 calc(var(--site-gap-near) + (var(--sp-24) - var(--tap)) / 2);
    font-size: var(--fs-15);
  }
  /* The page's prose, at no weight of its own: a page's own heading or paragraph, the lede and a list's heading keep
     the look their own rules give them. */
  :global(:where(.text-page) :where(h2)) {
    margin: var(--sp-32) 0 var(--sp-12);
    font-family: var(--site-font);
    font-size: var(--site-fs-article-head);
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  :global(:where(.text-page) :where(p)) {
    margin: 0 0 var(--site-gap-paragraph);
    text-wrap: pretty;
  }
</style>
