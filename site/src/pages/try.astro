---
import { getImage } from "astro:assets";
import { pageTitles, teaserPair } from "../content/site.ts";
import TryOn from "../islands/TryOn.tsx";
import Site from "../layouts/Site.astro";
import { IS_PRODUCTION } from "../lib/build.ts";
import { designImage } from "../lib/images.ts";

// Until F3 renders real results, the result screen shows the teaser's pair.
// Production never ships them.
async function standIn(file: string): Promise<string> {
  if (IS_PRODUCTION) return "";
  return (await getImage({ src: designImage(file), format: "webp", width: 1040 })).src;
}
const mockBefore = await standIn(teaserPair.before.file);
const mockAfter = await standIn(teaserPair.after.file);
---

<Site title={pageTitles.tryOn}>
  <TryOn client:load mockBefore={mockBefore} mockAfter={mockAfter} allowStateSwitch={!IS_PRODUCTION} />
</Site>
