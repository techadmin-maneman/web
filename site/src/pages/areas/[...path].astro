---
// Where we come (src/content/guides.ts): the cities, at /areas. Built for staging under the design's "Placeholder" tag
// until its wording is approved; production builds it only then.
import { buttonLook } from "@maneman/ui/Button";
import { areasPage } from "../../content/guides.ts";
import { placeholderTag } from "../../content/site.ts";
import Site from "../../layouts/Site.astro";
import { isShown, SHOW_PLACEHOLDER_TAGS } from "../../lib/build.ts";

export function getStaticPaths() {
  return isShown(areasPage) ? [{ params: { path: undefined } }] : [];
}
---

<Site title={areasPage.pageTitle} description={areasPage.description}>
  <article class="page">
    {SHOW_PLACEHOLDER_TAGS && !areasPage.publish && <div class="label tag">{placeholderTag}</div>}
    <h1 class="section-title">{areasPage.title}</h1>
    <p class="lead" data-cities={areasPage.cities}>
      {areasPage.lead}
    </p>
    <p>{areasPage.streets}</p>
    <p>{areasPage.next}</p>
    <a class={buttonLook({ variant: "primary", size: "action", className: "book" })} href="/book">
      {areasPage.check}
    </a>
  </article>
</Site>

<style>
  .page {
    max-width: var(--measure-column);
    margin: 0 auto;
    padding: var(--book-pad-top) var(--gutter) var(--section-gap);
    min-height: calc(100vh - var(--header-h));
  }
  .tag {
    display: inline-block;
    margin-bottom: var(--sp-24);
  }
  .lead,
  p {
    margin: var(--sp-16) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-160);
    text-wrap: pretty;
  }
  .lead {
    color: var(--text-muted);
  }
  .book {
    margin-top: var(--sp-48);
  }
</style>
