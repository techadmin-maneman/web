---
// A city's page, at /areas/<city>, for each city ops serve (src/lib/served-cities.ts): where a search for a hair system
// in that city lands, and the city's paid ads too (docs/decisions/0326-one-page-per-city.md). The home page's own
// sections, with no price: the hero, which names the city, and the city's own footage where it has some; its clients'
// films where it has them; the guarantee and the founder's note, with his own fit; the three steps at home; the
// try-on; the areas we cover there; the home page's questions; and the close. Built with the cities' page, so only
// while that page is shown. The site's Worker lists the areas served there, and sends a city served nowhere to /areas.
import CityAreas from "../../components/home/CityAreas.astro";
import Closing from "../../components/home/Closing.astro";
import Faq from "../../components/home/Faq.astro";
import Films from "../../components/home/Films.astro";
import GuaranteeFounder from "../../components/home/GuaranteeFounder.astro";
import Hero from "../../components/home/Hero.astro";
import HowItWorks from "../../components/home/HowItWorks.astro";
import TryOnTeaser from "../../components/home/TryOnTeaser.astro";
import { areasPage, cityPage, guidesPage } from "../../content/guides.ts";
import { cityMedia, founderFilm } from "../../content/site.ts";
import Site from "../../layouts/Site.astro";
import { isShown } from "../../lib/build.ts";
import { citySlug } from "../../lib/cities.ts";
import { SERVED_CITIES } from "../../lib/served-cities.ts";
import { breadcrumbs, faqPage, localBusiness, organization } from "../../lib/structured-data.ts";
import { fill } from "../../lib/text.ts";

export function getStaticPaths() {
  if (!isShown(areasPage) || !isShown(cityPage)) return [];
  return SERVED_CITIES.map((city) => ({ params: { city: citySlug(city) }, props: { city } }));
}

interface Props {
  city: string;
}

const { city } = Astro.props;
const words = (text: string) => fill(text, { city });
const media = cityMedia[city];
const trail = [
  { name: guidesPage.home, path: "/" },
  { name: areasPage.title, path: "/areas" },
  { name: words(cityPage.title), path: `/areas/${citySlug(city)}` },
];
const structuredData = [organization(), localBusiness(), faqPage(), breadcrumbs(trail)];
---

<Site
  title={words(cityPage.pageTitle)}
  description={words(cityPage.description)}
  structuredData={structuredData}
  sections={["faq"]}
  home
>
  <Hero footage={media?.hero} area={words(cityPage.area)} />
  {media !== undefined && <Films films={media.films} />}
  <GuaranteeFounder film={isShown(founderFilm) ? founderFilm : undefined} />
  <HowItWorks />
  <TryOnTeaser />
  <CityAreas city={city} />
  <Faq />
  <Closing />
</Site>
