---
// A city's page, at /areas/<city>, for each city the FAQ names (src/content/guides.ts, cityPage). It is built with
// its areas hidden: the site's Worker lists those it serves there, from the served pincodes, and shows them; it sends
// a city served nowhere to /areas, and leaves such cities out of the list of others. Built with the cities' page, so
// only while that page is shown.
import { buttonLook } from "@maneman/ui/Button";
import { textLinkLook } from "@maneman/ui/TextLink";
import { areasPage, cityPage, guidesPage } from "../../content/guides.ts";
import { business } from "../../content/site.ts";
import TextPage from "../../layouts/TextPage.astro";
import { isShown } from "../../lib/build.ts";
import { citySlug } from "../../lib/cities.ts";
import { breadcrumbs } from "../../lib/structured-data.ts";
import { fill } from "../../lib/text.ts";

export function getStaticPaths() {
  if (!isShown(areasPage) || !isShown(cityPage)) return [];
  return business.areaServed.map((city) => ({ params: { city: citySlug(city) }, props: { city } }));
}

interface Props {
  city: string;
}

const { city } = Astro.props;
const words = (text: string) => fill(text, { city });
const others = business.areaServed.filter((other) => other !== city);
const trail = [
  { name: guidesPage.home, path: "/" },
  { name: areasPage.title, path: "/areas" },
  { name: words(cityPage.title), path: `/areas/${citySlug(city)}` },
];
---

<TextPage
  pageTitle={words(cityPage.pageTitle)}
  description={words(cityPage.description)}
  title={words(cityPage.title)}
  lead={words(cityPage.lead)}
  publish={cityPage.publish}
  structuredData={[breadcrumbs(trail)]}
>
  <section data-city-areas={city} hidden>
    <h2>{words(cityPage.areas)}</h2>
    <ul class="areas" data-areas-of={city}></ul>
  </section>
  <p>{cityPage.streets}</p>
  <a class={buttonLook({ variant: "primary", size: "action", className: "book" })} href="/book">
    {cityPage.check}
  </a>
  {others.length > 0 && (
    <nav class="others" aria-labelledby="other-cities">
      <h2 id="other-cities">{cityPage.others}</h2>
      <ul>
        {others.map((other) => (
          <li data-city={other}>
            <a class={textLinkLook({ inline: true })} href={`/areas/${citySlug(other)}`}>
              {fill(cityPage.title, { city: other })}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</TextPage>

<style>
  .areas,
  .others ul {
    margin: var(--sp-16) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-8);
    font-size: var(--fs-lead);
  }
  .areas {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--column-min-narrow)), 1fr));
  }
  .book {
    margin-top: var(--sp-48);
  }
  .others {
    margin-top: var(--sp-48);
    padding-top: var(--sp-24);
    border-top: var(--hairline) solid var(--paper-line);
  }
  .others h2 {
    margin-top: 0;
  }
</style>
