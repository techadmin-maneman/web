---
import { buttonLook } from "@maneman/ui/Button";
import { notFound, pageTitles } from "../content/site.ts";
import Site from "../layouts/Site.astro";
---

<Site title={pageTitles.notFound} noindex>
  <section class="text-page short">
    <h1 class="page-title">{notFound.title}</h1>
    <p class="page-lede">{notFound.body}</p>
    <a class={buttonLook({ variant: "primary", size: "action", className: "home" })} href="/">
      {notFound.home}
    </a>
  </section>
</Site>

<style>
  .home {
    margin-top: var(--sp-28);
  }
  /* Across a phone; on a laptop, as wide as its words. */
  @media (min-width: 761px) {
    .home {
      width: fit-content;
    }
  }
</style>
