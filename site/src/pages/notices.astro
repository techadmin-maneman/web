---
// The full notices each one-line consent links to, a section each, under the anchor its line names (ADR 0219).
import { noticesPage, noticeSections, pageDescriptions, pageTitles } from "../content/site.ts";
import TextPage from "../layouts/TextPage.astro";
---

<TextPage
  pageTitle={pageTitles.notices}
  description={pageDescriptions.notices}
  title={noticesPage.title}
  publish={false}
>
  {Object.entries(noticeSections).map(([id, section]) => (
    <section id={id}>
      <h2>{section.heading}</h2>
      <dl>
        {section.rows.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.says}</dd>
          </div>
        ))}
      </dl>
    </section>
  ))}
</TextPage>

<style>
  /* A notice's rows between hairlines: what each covers, then what it says. */
  dl {
    margin: 0;
  }
  dl > div {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-12) 0;
    border-top: var(--hairline) solid var(--site-line);
  }
  dt {
    font-weight: var(--weight-semibold);
  }
  dd {
    margin: 0;
  }
</style>
