---
// The guides (src/content/guides.ts): their list at /guides and each at /guides/<slug>. A guide whose wording is not yet
// approved is built for staging under the design's "Placeholder" tag, and production builds no page for it;
// with none approved, production has no /guides at all.
import { capsLook } from "@maneman/ui/Caps";
import { textLinkLook } from "@maneman/ui/TextLink";
import { buttonLook } from "@maneman/ui/Button";
import { guides, guidesPage, type Guide } from "../../content/guides.ts";
import { placeholderTag } from "../../content/site.ts";
import Site from "../../layouts/Site.astro";
import { isShown, SHOW_PLACEHOLDER_TAGS } from "../../lib/build.ts";

export function getStaticPaths() {
  const shown = guides.filter(isShown);
  if (shown.length === 0) return [];
  return [
    { params: { path: undefined }, props: { guide: null } },
    ...shown.map((guide) => ({ params: { path: guide.slug }, props: { guide } })),
  ];
}

interface Props {
  guide: Guide | null;
}

const { guide } = Astro.props;
const shown = guides.filter(isShown);
---

{guide === null ? (
  <Site title={guidesPage.pageTitle} description={guidesPage.description}>
    <article class="page">
      <h1 class="section-title">{guidesPage.title}</h1>
      <p class="lead">{guidesPage.lead}</p>
      <ul class="list">
        {shown.map((each) => (
          <li>
            <a class={textLinkLook({ inline: true, className: "title" })} href={`/guides/${each.slug}`}>
              {each.title}
            </a>
            <p>{each.description}</p>
          </li>
        ))}
      </ul>
    </article>
  </Site>
) : (
  <Site title={`${guide.title} · Mane Man`} description={guide.description}>
    <article class="page">
      {SHOW_PLACEHOLDER_TAGS && !guide.publish && <div class={capsLook("label tag")}>{placeholderTag}</div>}
      <h1 class="section-title">{guide.title}</h1>
      <p class="lead">{guide.lead}</p>
      {guide.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
      <a class={buttonLook({ variant: "primary", size: "action", className: "book" })} href="/book">
        {guidesPage.book}
      </a>
    </article>
  </Site>
)}

<style>
  .page {
    max-width: var(--measure-column);
    margin: 0 auto;
    padding: var(--book-pad-top) var(--gutter) var(--section-gap);
    min-height: calc(100vh - var(--header-h));
  }
  .tag {
    display: inline-block;
    margin-bottom: var(--sp-24);
  }
  .lead {
    margin: var(--sp-16) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-160);
    color: var(--text-muted);
  }
  h2 {
    margin: var(--sp-48) 0 0;
    font-family: var(--font-serif);
    font-size: var(--fs-24);
    font-weight: var(--weight-regular);
    line-height: var(--lh-130);
  }
  p {
    margin: var(--sp-16) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-160);
    text-wrap: pretty;
  }
  .list {
    margin: var(--sp-48) 0 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    padding: var(--sp-24) 0;
    border-top: var(--hairline) solid var(--paper-line);
  }
  .title {
    font-family: var(--font-serif);
    font-size: var(--fs-24);
    line-height: var(--lh-130);
  }
  .list p {
    margin-top: var(--sp-8);
    font-size: var(--fs-body);
    color: var(--text-muted);
  }
  .book {
    margin-top: var(--sp-48);
  }
</style>
