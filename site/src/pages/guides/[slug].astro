---
// A guide (src/content/guides.ts), at /guides/<slug>. One whose wording is not yet approved is built for staging under
// the design's "Placeholder" tag, and production builds no page for it. Search engines are told it is an article,
// when it was written and changed and by whom, and the way back to the home page; beneath it are the other guides,
// the try-on and the home page's questions.
import { buttonLook } from "@maneman/ui/Button";
import { textLinkLook } from "@maneman/ui/TextLink";
import { guides, guidesPage, type Guide } from "../../content/guides.ts";
import TextPage from "../../layouts/TextPage.astro";
import { isShown } from "../../lib/build.ts";
import { breadcrumbs, guideArticle } from "../../lib/structured-data.ts";
import DesignPicture from "../../components/DesignPicture.astro";

/** How many of the other guides each guide links. */
const RELATED = 3;
/** A guide of this many sections or more opens with a link to each. */
const CONTENTS_FROM = 4;

/** A paragraph that names a term first, "Single knot: one small knot…": the term, up to three words, and the rest. */
function termOf(paragraph: string): { term: string; rest: string } | null {
  const found = /^([A-Z][\w,-]*(?: [\w,-]+){0,2}): (.+)$/.exec(paragraph);
  return found === null ? null : { term: found[1] ?? "", rest: found[2] ?? "" };
}

/** A section's place on the page, from its heading: "the-base-lace-mono-skin-and-silk". */
const anchorOf = (heading: string) =>
  heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

export function getStaticPaths() {
  return guides.filter(isShown).map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const shown = guides.filter(isShown);
const at = shown.indexOf(guide);
// The guides after this one, coming round to the first, so each is linked from as many others.
const related = [...shown.slice(at + 1), ...shown.slice(0, at)].slice(0, RELATED);
const trail = [
  { name: guidesPage.home, path: "/" },
  { name: guidesPage.title, path: "/guides" },
  { name: guide.title, path: `/guides/${guide.slug}` },
];
---

<TextPage
  pageTitle={`${guide.title} — Mane Man`}
  description={guide.description}
  title={guide.title}
  lead={guide.lead}
  publish={guide.publish}
  structuredData={[guideArticle(guide), breadcrumbs(trail)]}
  ogType="article"
>
  {guide.picture !== undefined && (
    <div class="frame picture">
      <DesignPicture
        file={guide.picture.file}
        alt={guide.picture.alt}
        sizes="(min-width: 761px) 680px, 100vw"
        widths={[390, 780, 1200]}
      />
    </div>
  )}
  {guide.sections.length >= CONTENTS_FROM && (
    <nav class="contents" aria-labelledby="guide-contents">
      <h2 id="guide-contents">{guidesPage.contents}</h2>
      <ol>
        {guide.sections.map((section) => (
          <li>
            <a class={textLinkLook({ inline: true })} href={`#${anchorOf(section.heading)}`}>
              {section.heading}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}
  {guide.sections.map((section) => (
    <section>
      <h2 id={anchorOf(section.heading)}>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => {
        const term = termOf(paragraph);
        return term === null ? (
          <p>{paragraph}</p>
        ) : (
          <p>
            <strong class="term">{term.term}</strong>: {term.rest}
          </p>
        );
      })}
    </section>
  ))}
  <a class={buttonLook({ variant: "primary", size: "action", className: "book" })} href="/book">
    {guidesPage.book}
  </a>
  {related.length > 0 && (
    <nav class="related" aria-labelledby="related-guides">
      <h2 id="related-guides">{guidesPage.related}</h2>
      <ul>
        {related.map((each) => (
          <li>
            <a class={textLinkLook({ inline: true })} href={`/guides/${each.slug}`}>
              {each.title}
            </a>
          </li>
        ))}
        <li>
          <a class={textLinkLook({ inline: true })} href="/try">
            {guidesPage.tryOn}
          </a>
        </li>
        <li>
          <a class={textLinkLook({ inline: true })} href="/#faq">
            {guidesPage.questions}
          </a>
        </li>
      </ul>
    </nav>
  )}
</TextPage>

<style>
  /* The photograph at 3:2, beneath the lead. */
  .picture {
    margin-top: var(--sp-32);
    aspect-ratio: 3 / 2;
    max-width: 100%;
  }
  .picture :global(picture),
  .picture :global(img) {
    position: absolute;
    inset: 0;
  }
  .contents {
    margin-top: var(--sp-32);
    padding: var(--sp-20) 0;
    border-block: var(--hairline) solid var(--paper-line);
  }
  .contents h2 {
    margin: 0;
    font-size: var(--fs-17);
  }
  .contents ol {
    margin: var(--sp-12) 0 0;
    padding-left: var(--sp-20);
    display: grid;
    gap: var(--sp-8);
    font-size: var(--fs-17);
  }
  h2[id] {
    scroll-margin-top: var(--bar-reserve);
  }
  .term {
    font-weight: var(--weight-medium);
  }
  .book {
    margin-top: var(--sp-48);
  }
  .related {
    margin-top: var(--sp-48);
    padding-top: var(--sp-24);
    border-top: var(--hairline) solid var(--paper-line);
  }
  .related h2 {
    margin-top: 0;
  }
  .related ul {
    margin: var(--sp-16) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-12);
    font-size: var(--fs-lead);
  }
</style>
