---
import Closing from "../components/home/Closing.astro";
import Comparison from "../components/home/Comparison.astro";
import DiscretionBand from "../components/home/DiscretionBand.astro";
import Faq from "../components/home/Faq.astro";
import GuaranteeFounder from "../components/home/GuaranteeFounder.astro";
import Hero from "../components/home/Hero.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import Materials from "../components/home/Materials.astro";
import Norwood from "../components/home/Norwood.astro";
import Range from "../components/home/Range.astro";
import Technicians from "../components/home/Technicians.astro";
import Testimonials from "../components/home/Testimonials.astro";
import TryOnTeaser from "../components/home/TryOnTeaser.astro";
import WhatItIs from "../components/home/WhatItIs.astro";
import { pageDescriptions, pageTitles } from "../content/site.ts";
import Site from "../layouts/Site.astro";
import { faqPage, localBusiness, organization, webSite } from "../lib/structured-data.ts";

const structuredData = [organization(), webSite(), localBusiness(), faqPage()];
---

<Site title={pageTitles.home} description={pageDescriptions.home} structuredData={structuredData} home>
  <Fragment slot="head">
    <script is:inline>
      // Ads link to #tryon and #book, so both still lead where they did.
      if (location.hash === "#tryon") location.replace("/try");
      else if (location.hash === "#book") location.replace("/book");
    </script>
  </Fragment>
  <Hero />
  <WhatItIs />
  <Norwood />
  <Comparison />
  <TryOnTeaser />
  <DiscretionBand />
  <HowItWorks />
  <Technicians />
  <Range />
  <Materials />
  <Testimonials />
  <GuaranteeFounder />
  <Faq />
  <Closing />
</Site>
