---
// A comparison: options across the top, a row for each way they differ, as a table to assistive technology and the
// design's grid to the eye. On a phone, where three or four columns squeezed every cell onto four lines, each option
// is a card of its own instead, the cards side by side to swipe through, each listing every row.
// A cell is words, or a tick (true) or a cross (false), read as Yes and No.
import { hiddenLook } from "@maneman/ui/VisuallyHidden";
import { capsLook } from "@maneman/ui/Caps";
import type { ComparisonCell } from "../content/site.ts";
import Icon from "./Icon.astro";

interface Props {
  /** What a screen reader calls the table. */
  label: string;
  columns: readonly string[];
  rows: readonly { readonly label: string; readonly cells: readonly ComparisonCell[] }[];
  yes: string;
  no: string;
}

const { label, columns, rows, yes, no } = Astro.props;
const across = columns.length === 4 ? "four" : "three";
const isMark = (cell: ComparisonCell): cell is boolean => typeof cell === "boolean";
---

<div class:list={["table", across]} role="table" aria-label={label}>
  <div class="row head" role="row">
    <div class="label-cell corner" role="columnheader">
      <span class={hiddenLook}>{label}</span>
    </div>
    {columns.map((column) => (
      <div class="cell column-head" role="columnheader">
        {column}
      </div>
    ))}
  </div>
  {rows.map((row) => (
    <div class="row" role="row">
      <div class={capsLook("label-cell")} role="rowheader">
        {row.label}
      </div>
      {row.cells.map((cell) => (
        <div class="cell" role="cell">
          {isMark(cell) ? (
            <>
              <Icon name={cell ? "tick" : "cross"} size="sm" class={cell ? "yes" : "no"} />
              <span class={hiddenLook}>{cell ? yes : no}</span>
            </>
          ) : (
            <span>{cell}</span>
          )}
        </div>
      ))}
    </div>
  ))}
</div>

<ul class="cards" aria-label={label} tabindex="0">
  {columns.map((column, at) => (
    <li class="card">
      <p class="card-title">{column}</p>
      <dl>
        {rows.map((row) => {
          const cell = row.cells[at];
          return (
            <div class="pair">
              <dt class={capsLook("card-label")}>{row.label}</dt>
              <dd>
                {cell === undefined ? null : isMark(cell) ? (
                  <>
                    <Icon name={cell ? "tick" : "cross"} size="sm" class={cell ? "yes" : "no"} />
                    <span class={hiddenLook}>{cell ? yes : no}</span>
                  </>
                ) : (
                  cell
                )}
              </dd>
            </div>
          );
        })}
      </dl>
    </li>
  ))}
</ul>

<style>
  .table {
    border-top: var(--hairline) solid var(--text);
  }
  .row {
    display: grid;
    grid-template-columns: var(--comparison-label-w) repeat(3, 1fr);
    align-items: center;
    padding: var(--sp-20) 0;
    border-top: var(--hairline) solid var(--paper-line);
  }
  .four .row {
    grid-template-columns: var(--comparison-label-w) repeat(4, 1fr);
  }
  .head {
    align-items: stretch;
    padding: var(--space-2xs) 0 var(--space-2xs);
    border-top: 0;
  }
  .label-cell {
    padding: 0 var(--sp-20) 0 0;
    letter-spacing: var(--tracking-12);
    font-size: var(--fs-18);
    color: var(--text-muted);
  }
  .cell {
    padding: 0 var(--space-2xs);
    border-left: var(--hairline) solid var(--paper-line);
    font-size: var(--fs-17);
    line-height: var(--lh-145);
  }
  .label-cell + .cell {
    padding-left: 0;
    border-left: 0;
  }
  .cell:last-child {
    padding-right: 0;
  }
  .column-head {
    font-family: var(--font-serif);
    font-size: var(--fs-h5);
    line-height: var(--lh-115);
  }
  .yes {
    color: var(--ink);
  }
  .no {
    color: var(--text-muted);
  }

  /* A phone's cards, a little narrower than the screen so the next one shows at the edge. */
  .cards {
    display: none;
  }
  @media (max-width: 760px) {
    .table {
      display: none;
    }
    /* It scrolls within itself, a keyboard's arrows too, and never widens the page: positioned, so the words only a
       screen reader hears scroll and clip with their card. */
    .cards {
      position: relative;
      display: grid;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      grid-auto-flow: column;
      grid-auto-columns: var(--compare-card-w);
      gap: var(--sp-12);
      margin: 0;
      padding: 0 0 var(--sp-8);
      list-style: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }
    .card {
      scroll-snap-align: start;
      padding: var(--sp-20);
      background: var(--paper-light);
      border-top: var(--rule-strong) solid var(--ink);
    }
    .card-title {
      margin: 0;
      font-family: var(--font-serif);
      font-size: var(--fs-h5);
      line-height: var(--lh-115);
    }
    dl {
      margin: var(--sp-12) 0 0;
    }
    .pair {
      padding: var(--sp-12) 0;
      border-top: var(--hairline) solid var(--paper-line);
    }
    .card-label {
      letter-spacing: var(--tracking-12);
      font-size: var(--fs-16);
      color: var(--text-muted);
    }
    dd {
      margin: var(--sp-4) 0 0;
      font-size: var(--fs-17);
      line-height: var(--lh-145);
    }
  }
</style>
