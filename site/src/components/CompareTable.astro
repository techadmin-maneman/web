---
// A comparison as a table: options across the top, a row for each way they differ. A table to assistive technology;
// to the eye, the design's grid. Below 760 px each row's label moves above it, and the options keep their columns.
// A cell is words, or a tick (true) or a cross (false), read as Yes and No.
import { hiddenLook } from "@maneman/ui/VisuallyHidden";
import { capsLook } from "@maneman/ui/Caps";
import type { ComparisonCell } from "../content/site.ts";
import Icon from "./Icon.astro";

interface Props {
  /** What a screen reader calls the table. */
  label: string;
  columns: readonly string[];
  rows: readonly { readonly label: string; readonly cells: readonly ComparisonCell[] }[];
  yes: string;
  no: string;
}

const { label, columns, rows, yes, no } = Astro.props;
const across = columns.length === 4 ? "four" : "three";
const isMark = (cell: ComparisonCell): cell is boolean => typeof cell === "boolean";
---

<div class:list={["table", across]} role="table" aria-label={label}>
  <div class="row head" role="row">
    <div class="label-cell corner" role="columnheader">
      <span class={hiddenLook}>{label}</span>
    </div>
    {columns.map((column) => (
      <div class="cell column-head" role="columnheader">
        {column}
      </div>
    ))}
  </div>
  {rows.map((row) => (
    <div class="entry" role="rowgroup">
      <div class={capsLook("label-above")} aria-hidden="true">
        {row.label}
      </div>
      <div class="row" role="row">
        <div class={capsLook("label-cell row-label")} role="rowheader">
          {row.label}
        </div>
        {row.cells.map((cell) => (
          <div class="cell" role="cell">
            {isMark(cell) ? (
              <>
                <Icon name={cell ? "tick" : "cross"} size="sm" class={cell ? "yes" : "no"} />
                <span class={hiddenLook}>{cell ? yes : no}</span>
              </>
            ) : (
              <span>{cell}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .table {
    border-top: var(--hairline) solid var(--text);
  }
  .row {
    display: grid;
    grid-template-columns: var(--comparison-label-w) repeat(3, 1fr);
    align-items: center;
    padding: var(--sp-20) 0;
  }
  .four .row {
    grid-template-columns: var(--comparison-label-w) repeat(4, 1fr);
  }
  .head {
    align-items: stretch;
    padding: var(--space-2xs) 0 var(--space-2xs);
  }
  .entry {
    border-top: var(--hairline) solid var(--paper-line);
  }
  .label-above {
    display: none;
    padding: var(--sp-16) 0 var(--sp-8);
    letter-spacing: var(--tracking-12);
    font-size: var(--fs-15);
    color: var(--text-muted);
  }
  .label-cell {
    padding: 0 var(--sp-20) 0 0;
    letter-spacing: var(--tracking-12);
    font-size: var(--fs-17);
    color: var(--text-muted);
  }
  .cell {
    padding: 0 var(--space-2xs);
    border-left: var(--hairline) solid var(--paper-line);
    font-size: var(--fs-17);
    line-height: var(--lh-145);
  }
  .label-cell + .cell {
    padding-left: 0;
    border-left: 0;
  }
  .cell:last-child {
    padding-right: 0;
  }
  .column-head {
    font-family: var(--font-serif);
    font-size: var(--fs-h5);
    line-height: var(--lh-115);
  }
  .yes {
    color: var(--ink);
  }
  .no {
    color: var(--text-muted);
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: repeat(3, 1fr);
      padding: 0 0 var(--sp-16);
    }
    .four .row {
      grid-template-columns: repeat(4, 1fr);
    }
    .head {
      padding: var(--space-2xs) 0 var(--space-2xs);
    }
    .corner {
      display: none;
    }
    /* The label is above the row now; screen readers still hear it as the row header. */
    .row-label {
      position: absolute;
      width: var(--sr-only-size);
      height: var(--sr-only-size);
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .label-above {
      display: block;
    }
    .cell {
      font-size: var(--fs-15);
    }
    .four .cell {
      padding: 0 var(--sp-8);
      font-size: var(--fs-14);
    }
    .four .label-cell + .cell {
      padding-left: 0;
    }
    .column-head {
      font-size: var(--fs-h5);
    }
    .four .column-head {
      font-size: var(--fs-lead);
    }
  }
</style>
