---
// A comparison on a laptop (ADR 0263): options across the top, a row for each way they differ, as a table to
// assistive technology and the board's table to the eye. A phone draws the same rows as toggles
// (../islands/home/CompareToggle.tsx). Where `ours` is set, the last column, the hair system, stands out on white.
// A cell is words, or true or false, written Yes and No as the boards write them.
import { hiddenLook } from "@maneman/ui/VisuallyHidden";
import type { ComparisonCell } from "../content/site.ts";

interface Props {
  /** What a screen reader calls the table, and its first column. */
  label: string;
  columns: readonly string[];
  rows: readonly { readonly label: string; readonly cells: readonly ComparisonCell[] }[];
  yes: string;
  no: string;
  ours?: boolean;
}

const { label, columns, rows, yes, no, ours = false } = Astro.props;
const last = columns.length - 1;
const across = columns.length === 4 ? "four" : "three";
const isMark = (cell: ComparisonCell): cell is boolean => typeof cell === "boolean";
---

<div class:list={["table", across]} role="table" aria-label={label}>
  <div class="row head" role="row">
    <div class="key" role="columnheader">
      <span class={hiddenLook}>{label}</span>
    </div>
    {columns.map((column, at) => (
      <div class:list={["cell", ours && at === last && "ours"]} role="columnheader">
        {column}
      </div>
    ))}
  </div>
  {rows.map((row) => (
    <div class="row" role="row">
      <div class="key" role="rowheader">
        {row.label}
      </div>
      {row.cells.map((cell, at) => (
        <div class:list={["cell", ours && at === last && "ours", ours && at !== last && "theirs"]} role="cell">
          <span>{isMark(cell) ? (cell ? yes : no) : cell}</span>
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .table {
    display: none;
    margin-top: var(--site-gap-list);
  }
  .three {
    --columns: 3;
  }
  .four {
    --columns: 4;
  }
  .row {
    display: grid;
    grid-template-columns: var(--comparison-label-w) repeat(var(--columns), minmax(0, 1fr));
    border-bottom: var(--hairline) solid var(--site-line);
  }
  .head {
    border-bottom: var(--rule-strong) solid var(--site-navy);
  }
  .key,
  .cell {
    padding: var(--sp-16);
    font-size: var(--site-fs-body);
    line-height: var(--lh-145);
  }
  .key {
    font-size: var(--site-fs-label);
    font-weight: var(--weight-semibold);
    color: var(--site-text-muted);
  }
  .head .cell {
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  .theirs {
    color: var(--site-text-muted);
  }
  .ours {
    background: var(--site-ground);
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  @media (min-width: 761px) {
    .table {
      display: block;
    }
  }
</style>
