---
// The drawings every page's header draws: the brand kit's mark and the small cut of the wordmark
// (@maneman/brand/marks), used with <use href="#…">. A drawing one page alone draws is drawn there.
import { MARK, WORDMARK_SMALL } from "@maneman/brand/marks";
---

<svg class="sprite" aria-hidden="true">
  <defs>
    <symbol id="mm" viewBox={MARK.viewBox}>
      <path fill-rule="evenodd" d={MARK.d}></path>
    </symbol>
    <symbol id="wms" viewBox={WORDMARK_SMALL.viewBox}>
      <path d={WORDMARK_SMALL.d}></path>
    </symbol>
  </defs>
</svg>

<style>
  .sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
