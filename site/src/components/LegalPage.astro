---
// The privacy policy or the terms, as counsel's documents lay them out: the version, the opening paragraphs, the
// numbered sections and their clauses, and a table after them where there is one.
import { tableLook } from "@maneman/ui/Table";
import type { LegalPage } from "../content/site.ts";
import TextPage from "../layouts/TextPage.astro";
import LegalBlocks from "./LegalBlocks.astro";
import LinkedText from "./LinkedText.astro";

interface Props {
  pageTitle: string;
  description: string;
  page: LegalPage;
}

const { pageTitle, description, page } = Astro.props;
---

<TextPage pageTitle={pageTitle} description={description} title={page.title} publish={page.publish}>
  <table class={tableLook({ plain: true, className: "version" })}>
    <tbody>
      <tr>
        <th scope="row">Version Number</th>
        <td>{page.version.number}</td>
      </tr>
      <tr>
        <th scope="row">Publication / Update Date</th>
        <td>{page.version.date}</td>
      </tr>
    </tbody>
  </table>
  {page.intro.map((paragraph) => (
    <p>
      <LinkedText text={paragraph} />
    </p>
  ))}
  {page.sections.map((section, index) => (
    <section>
      <h2>
        <span class="number">{index + 1}.</span>
        {section.heading}
      </h2>
      <LegalBlocks blocks={section.blocks} depth={1} section={index + 1} />
    </section>
  ))}
  {page.annex !== undefined && (
    <section>
      <h2>{page.annex.heading}</h2>
      <table class={tableLook({ plain: true, className: "annex" })}>
        <thead>
          <tr>
            {page.annex.head.map((cell) => (
              <th scope="col">{cell}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {page.annex.rows.map((row) => (
            <tr>
              {row.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <p>{page.annex.note}</p>
    </section>
  )}
</TextPage>

<style>
  table {
    width: 100%;
    margin: var(--sp-24) 0 0;
    border-collapse: collapse;
    font-size: var(--fs-16);
    line-height: var(--lh-145);
  }
  th,
  td {
    padding: var(--sp-8) var(--sp-12) var(--sp-8) 0;
    border-bottom: var(--hairline) solid var(--paper-line);
    text-align: start;
    vertical-align: top;
  }
  th {
    font-weight: var(--weight-medium);
  }
  .version {
    width: auto;
    color: var(--text-muted);
  }
  .number {
    display: inline-block;
    min-width: var(--sp-48);
    font-variant-numeric: tabular-nums;
  }
</style>
