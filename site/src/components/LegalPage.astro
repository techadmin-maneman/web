---
// The privacy notice or the terms: a heading per topic, the business number written in as a link to a WhatsApp chat.
import { textLinkLook } from "@maneman/ui/TextLink";
import { whatsappChat } from "@maneman/web-kit/whatsapp";
import { whatsapp, type LegalPage } from "../content/site.ts";
import TextPage from "../layouts/TextPage.astro";
import { aroundWhatsapp } from "../lib/text.ts";

interface Props {
  pageTitle: string;
  description: string;
  page: LegalPage;
}

const { pageTitle, description, page } = Astro.props;
const chat = whatsappChat(whatsapp.number);
---

<TextPage pageTitle={pageTitle} description={description} title={page.title} publish={page.publish}>
  {page.sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>
          {aroundWhatsapp(paragraph).map((text, index) => [
            index > 0 && (
              <a class={textLinkLook({ inline: true, className: "chat" })} href={chat}>
                {whatsapp.display}
              </a>
            ),
            text,
          ])}
        </p>
      ))}
    </section>
  ))}
</TextPage>

<style>
  /* In the sentence's own colour, so underlined to be seen as a link. */
  .chat {
    white-space: nowrap;
  }
</style>
