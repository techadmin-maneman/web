---
// The range: the four hair systems side by side, as the product guide compares them, with no price.
import CompareTable from "../CompareTable.astro";
import { comparison, range } from "../../content/site.ts";
---

<section id="range" class="container range" data-section="range">
  <h2 class="section-title">{range.title}</h2>
  <p class="lead intro">{range.intro}</p>
  <CompareTable
    label={range.title}
    columns={range.products.map((product) => product.short)}
    rows={range.rows}
    yes={comparison.yes}
    no={comparison.no}
  />
</section>

<style>
  .range {
    padding-top: var(--section-gap);
  }
  .section-title {
    margin-bottom: var(--sp-12);
  }
  .intro {
    margin: 0 0 var(--space-l);
  }
</style>
