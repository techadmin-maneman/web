---
// "What it is", on the cool ground: its words, and its line under a navy rule beneath them on a phone, beside them on a
// laptop (ADR 0263).
import { whatItIs } from "../../content/site.ts";
---

<section id="what" class="band ground-cool" data-section="what">
  <div class="container what">
    <div>
      <h2 class="section-title">{whatItIs.title}</h2>
      <p class="body-text body">{whatItIs.body}</p>
    </div>
    <p class="statement line">{whatItIs.statement}</p>
  </div>
</section>

<style>
  .what {
    display: grid;
    gap: var(--site-space-12-20);
  }
  .body {
    margin-top: var(--site-space-12-20);
    font-size: var(--site-fs-lead);
  }
  .line {
    padding-top: var(--site-space-16-24);
    font-size: var(--site-fs-statement);
    line-height: var(--site-lh-statement);
    letter-spacing: var(--site-tracking-statement);
  }
  @media (min-width: 761px) {
    .what {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--site-columns-gap);
    }
    .line {
      align-self: end;
    }
  }
</style>
