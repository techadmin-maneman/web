---
// "What it is": its words, and its line beside them on a wide screen, beneath the results.
import { whatItIs } from "../../content/site.ts";
---

<section id="what" class="container what" data-section="what">
  <div class="words">
    <h2 class="section-title">{whatItIs.title}</h2>
    <p class="body">{whatItIs.body}</p>
  </div>
  <p class="statement">{whatItIs.statement}</p>
</section>

<style>
  .what {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--split-min-wide)), 1fr));
    gap: var(--space-xl) var(--space-2xl);
    align-items: end;
    padding-top: var(--section-gap);
  }
  .words {
    max-width: var(--measure-column);
  }
  .body {
    margin: var(--sp-24) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-160);
    color: var(--text);
    text-wrap: pretty;
  }
  .statement {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    line-height: var(--lh-115);
    letter-spacing: var(--tracking-heading);
    color: var(--text);
    text-wrap: balance;
  }
</style>
