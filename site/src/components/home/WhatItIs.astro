---
// "What it is": a narrow column, beneath the results.
import { whatItIs } from "../../content/site.ts";
---

<section id="what" class="what" data-section="what">
  <div class="column">
    <h2 class="section-title">{whatItIs.title}</h2>
    <p class="body">{whatItIs.body}</p>
    <p class="statement">{whatItIs.statement}</p>
  </div>
</section>

<style>
  .column {
    max-width: var(--measure-column);
    margin: 0 auto;
    padding: var(--what-pad-top) var(--gutter) 0;
  }
  .body {
    margin: var(--sp-24) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-160);
    color: var(--text);
    text-wrap: pretty;
  }
  .statement {
    margin: var(--sp-32) 0 0;
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    line-height: var(--lh-115);
    letter-spacing: var(--tracking-heading);
    color: var(--text);
    text-wrap: balance;
  }
</style>
