---
// The closing band, on navy (ADR 0263): the consultation in a line, and the way to book, the screen's one filled button,
// beneath it on a phone and beside it on a laptop. The footer below has no Book of its own.
import { buttonLook } from "@maneman/ui/Button";
import { closing } from "../../content/site.ts";
---

<section class="ground-navy closing" data-section="closing">
  <div class="container inner">
    <h2 class="line">{closing.title}</h2>
    <a class={buttonLook({ variant: "goldOnNavy", size: "action", className: "book" })} href="/book" data-filled>
      {closing.book}
    </a>
  </div>
</section>

<style>
  .closing {
    padding-block: var(--site-closing-pad);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-20);
  }
  .line {
    margin: 0;
    font-size: var(--site-fs-closing);
    line-height: var(--lh-125);
    letter-spacing: var(--site-tracking-statement);
    font-weight: var(--weight-semibold);
    color: var(--site-on-navy);
  }
  @media (min-width: 761px) {
    .inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-40);
    }
    .line {
      max-width: var(--site-closing-max);
    }
  }
</style>
