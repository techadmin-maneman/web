---
// The discretion band: one sentence, large serif.
import { discretionBand } from "../../content/site.ts";
---

<section class="band" data-section="discretion">
  <div class="inner">
    <p>{discretionBand.text}</p>
  </div>
</section>

<style>
  .band {
    background: var(--ink-night);
  }
  .inner {
    max-width: var(--band-max);
    margin: 0 auto;
    padding: var(--discretion-pad-y) var(--discretion-pad-x);
    display: flex;
    justify-content: center;
  }
  p {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: var(--fs-band);
    line-height: var(--lh-108);
    letter-spacing: var(--tracking-display);
    color: var(--paper);
    text-align: center;
    text-wrap: balance;
  }
</style>
