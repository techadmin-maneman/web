---
// The guarantee beside the founder's note, on white (ADR 0263): one after the other on a phone, two columns on a
// laptop. The note's first paragraph shows, and the rest unfolds (../../islands/home/FounderNote.tsx). A page may add
// the founder's own fit, as the Gurgaon page does (ADR 0321): after the note on a phone; on a laptop the guarantee and
// the note run down the left, and the film stands beside both on the right, in the order a keyboard reaches them, so
// the note unfolds downward and nothing beside it moves.
import FilmCard from "../FilmCard.astro";
import FounderNote from "../../islands/home/FounderNote.tsx";
import { founderNote, guarantee, type Film } from "../../content/site.ts";
import { isShown } from "../../lib/build.ts";

interface Props {
  film?: Film | undefined;
}

const { film } = Astro.props;
---

<section class="band ground-white" data-section="guarantee">
  <div class:list={["container pair", { "with-film": film !== undefined }]}>
    <div class="guarantee-part">
      <h2 class="eyebrow">{guarantee.label}</h2>
      <p class="guarantee">{guarantee.text}</p>
    </div>
    {isShown(founderNote) && (
      <div class="founder-part" data-section="founder">
        <h2 class="eyebrow">{founderNote.label}</h2>
        <FounderNote paragraphs={founderNote.paragraphs} more={founderNote.more} />
        <p class="signature">
          <span class="name">{founderNote.name}</span>
          <span class="role">{founderNote.signature}</span>
        </p>
      </div>
    )}
    {film !== undefined && (
      <div class="founder-film">
        <FilmCard film={film} sizes="(min-width: 761px) 440px, 100vw" />
      </div>
    )}
  </div>
</section>

<style>
  .pair {
    display: grid;
    gap: var(--sp-40);
  }
  .guarantee-part {
    padding-top: var(--site-gap-block);
    border-top: var(--rule-strong) solid var(--site-navy);
  }
  .guarantee {
    margin: var(--site-gap-lede) 0 0;
    font-size: var(--site-fs-statement);
    line-height: var(--site-lh-statement);
    letter-spacing: var(--site-tracking-statement);
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
    text-wrap: balance;
  }
  .founder-part {
    padding-top: var(--site-gap-block);
    border-top: var(--hairline) solid var(--site-line);
  }
  .signature {
    display: flex;
    flex-direction: column;
    margin: var(--sp-16) 0 0;
    font-size: var(--site-fs-body);
  }
  .name {
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  .role {
    color: var(--site-text-muted);
  }
  @media (min-width: 761px) {
    .pair {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--site-columns-gap);
      align-items: start;
    }
    .with-film {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-areas: "guarantee film" "founder film";
      /* The first row is the guarantee's height alone; the note takes the rest, so it never moves as it unfolds. */
      grid-template-rows: auto 1fr;
      row-gap: var(--sp-40);
    }
    .with-film .guarantee-part {
      grid-area: guarantee;
    }
    .with-film .founder-part {
      grid-area: founder;
    }
    .with-film .founder-film {
      grid-area: film;
      justify-self: end;
      width: 100%;
      max-width: var(--site-film-w);
    }
  }
</style>
