---
// The guarantee beside the founder's note, on white (ADR 0263): one after the other on a phone, two columns on a
// laptop. The note's first paragraph shows, and the rest unfolds (../../islands/home/FounderNote.tsx).
import FounderNote from "../../islands/home/FounderNote.tsx";
import { founderNote, guarantee } from "../../content/site.ts";
import { isShown } from "../../lib/build.ts";
---

<section class="band ground-white" data-section="guarantee">
  <div class="container pair">
    <div class="guarantee-part">
      <h2 class="eyebrow">{guarantee.label}</h2>
      <p class="guarantee">{guarantee.text}</p>
    </div>
    {isShown(founderNote) && (
      <div class="founder-part" data-section="founder">
        <h2 class="eyebrow">{founderNote.label}</h2>
        <FounderNote paragraphs={founderNote.paragraphs} more={founderNote.more} />
        <p class="signature">
          <span class="name">{founderNote.name}</span>
          <span class="role">{founderNote.signature}</span>
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .pair {
    display: grid;
    gap: var(--sp-40);
  }
  .guarantee-part {
    padding-top: var(--site-gap-block);
    border-top: var(--rule-strong) solid var(--site-navy);
  }
  .guarantee {
    margin: var(--site-gap-lede) 0 0;
    font-size: var(--site-fs-statement);
    line-height: var(--site-lh-statement);
    letter-spacing: var(--site-tracking-statement);
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  .founder-part {
    padding-top: var(--site-gap-block);
    border-top: var(--hairline) solid var(--site-line);
  }
  .signature {
    display: flex;
    flex-direction: column;
    margin: var(--sp-16) 0 0;
    font-size: var(--site-fs-body);
  }
  .name {
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  .role {
    color: var(--site-text-muted);
  }
  @media (min-width: 761px) {
    .pair {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--site-columns-gap);
      align-items: start;
    }
  }
</style>
