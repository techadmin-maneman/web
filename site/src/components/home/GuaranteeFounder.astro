---
// The guarantee beside the founder's note with the mark: two columns on a wide screen, one after the other on a phone.
import { capsLook } from "@maneman/ui/Caps";
import { founderNote, guarantee } from "../../content/site.ts";
import { isShown } from "../../lib/build.ts";
---

<section class="container pair" data-section="guarantee">
  <div class="guarantee-part">
    <h2 class={capsLook("label-title")}>{guarantee.label}</h2>
    <p class="guarantee">{guarantee.text}</p>
  </div>
  {isShown(founderNote) && (
    <div class="founder-part" data-section="founder">
      <h2 class={capsLook("label-title")}>{founderNote.label}</h2>
      {founderNote.paragraphs.map((paragraph) => (
        <p class="note">{paragraph}</p>
      ))}
      <div class="signature">
        <svg class="mark" viewBox="0 0 200 217.4" width="30" height="33" aria-hidden="true">
          <use href="#mm" />
        </svg>
        <div>
          <p class="name">{founderNote.name}</p>
          <p class="role">{founderNote.signature}</p>
        </div>
      </div>
    </div>
  )}
</section>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--split-min-wide)), 1fr));
    gap: var(--space-2xl);
    padding-top: var(--section-gap);
  }
  .guarantee-part,
  .founder-part {
    max-width: var(--measure-column);
  }
  .label-title {
    margin: 0;
    font-weight: var(--weight-regular);
    font-size: var(--fs-16);
    color: var(--text-muted);
  }
  .guarantee {
    margin: var(--sp-16) 0 0;
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    line-height: var(--lh-130);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }
  .note {
    margin: var(--sp-16) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-160);
    color: var(--text);
    text-wrap: pretty;
  }
  .signature {
    margin-top: var(--sp-24);
    display: flex;
    align-items: center;
    gap: var(--sp-16);
  }
  .mark {
    fill: var(--ink);
  }
  .name,
  .role {
    margin: 0;
    font-family: var(--font-serif);
  }
  .name {
    font-size: var(--fs-lead);
    color: var(--text);
  }
  .role {
    font-size: var(--fs-16);
    color: var(--text-muted);
  }
</style>
