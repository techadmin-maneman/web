---
// Questions: ten disclosures, the first open, one open at a time. <details>
// sharing a `name` behave as one group, so this needs no script.
import { textLinkLook } from "@maneman/ui/TextLink";
import { ruledDisclosureLook as ruled } from "@maneman/ui/Disclosure";
import { faq, whatsapp } from "../../content/site.ts";
import { isShown } from "../../lib/build.ts";
import { asBuilt, priceTemplate } from "../../lib/prices.ts";
import { ICONS } from "@maneman/brand/icons";
import { whatsappChat } from "@maneman/web-kit/whatsapp";

// One expression, so no line break can put a space before the full stop.
const link = isShown(whatsapp) ? whatsappChat(whatsapp.number) : null;
---

<section id="faq" class="container faq" data-section="faq">
  <div class="intro">
    <h2 class="section-title">{faq.title}</h2>
    <p>
      {[
        faq.intro.before,
        link === null ? (
          faq.intro.link
        ) : (
          <a class={textLinkLook({ inline: true })} href={link}>
            {faq.intro.link}
          </a>
        ),
        faq.intro.after,
      ]}
    </p>
  </div>
  <div class="list">
    {faq.items.map((item, index) => (
      <details name="faq" open={index === 0} class={ruled.details}>
        <summary class={ruled.summary}>
          <span>{item.q}</span>
          <svg
            class={ruled.sign}
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d={ICONS.minus} />
            <path class={ruled.upright} d="M12 6 V18" />
          </svg>
        </summary>
        {"cities" in item ? (
          <p data-cities={item.cities}>{item.a}</p>
        ) : (
          <p data-price={priceTemplate(item.a)}>{asBuilt(item.a)}</p>
        )}
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    padding-top: var(--faq-pad-top);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--split-min)), 1fr));
    gap: var(--faq-gap);
    align-items: start;
  }
  .intro {
    max-width: var(--faq-intro-max);
  }
  .intro p {
    margin: var(--sp-24) 0 0;
    font-size: var(--fs-17);
    line-height: var(--lh-160);
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .list {
    border-top: var(--hairline) solid var(--text);
  }
  summary {
    font-size: var(--fs-lead);
    line-height: var(--lh-145);
  }
  details p {
    margin: 0 0 var(--sp-24);
    font-size: var(--fs-17);
    line-height: var(--lh-160);
    color: var(--text-soft);
    max-width: var(--measure-note);
    text-wrap: pretty;
  }
</style>
