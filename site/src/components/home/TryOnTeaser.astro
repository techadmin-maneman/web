---
// The try-on teaser, on navy (ADR 0263): its words, a before and after, and the way in. On a phone the button follows
// the picture; on a laptop it sits beneath the words, beside the picture.
import { buttonLook } from "@maneman/ui/Button";
import BeforeAfter from "../../islands/BeforeAfter.tsx";
import { placeholderTag, teaserPair, tryOnTeaser } from "../../content/site.ts";
import { isShown, isTaggedPlaceholder } from "../../lib/build.ts";
import DesignPicture from "../DesignPicture.astro";

const sizes = "(min-width: 761px) 640px, 100vw";
const widths = [390, 780, 1280];
---

<section class="teaser ground-navy" data-section="teaser">
  <div class="container inner">
    <div class="words">
      <p class="eyebrow">{tryOnTeaser.eyebrow}</p>
      <h2 class="section-title">{tryOnTeaser.title}</h2>
      <p class="lead">{tryOnTeaser.body}</p>
    </div>
    {isShown(teaserPair) && (
      <div class="picture">
        <BeforeAfter
          client:visible
          className="teaser-compare"
          start={tryOnTeaser.start_percent}
          beforeLabel={tryOnTeaser.before}
          afterLabel={tryOnTeaser.after}
          sliderLabel={tryOnTeaser.sliderLabel}
          sliderValue={tryOnTeaser.sliderValue}
          tag={isTaggedPlaceholder(teaserPair) ? placeholderTag : undefined}
        >
          <DesignPicture
            slot="after"
            file={teaserPair.after.file}
            alt={teaserPair.after.alt}
            sizes={sizes}
            widths={widths}
            class="focus-client"
          />
          <DesignPicture
            slot="before"
            file={teaserPair.before.file}
            alt={teaserPair.before.alt}
            sizes={sizes}
            widths={widths}
            class="focus-client"
          />
        </BeforeAfter>
      </div>
    )}
    <a class={buttonLook({ variant: "goldOnNavy", size: "action", className: "start" })} href="/try" data-filled>
      {tryOnTeaser.start}
    </a>
  </div>
</section>

<style>
  .teaser {
    padding: var(--site-teaser-pad-top) 0 var(--site-teaser-pad-bottom);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "words" "picture" "start";
  }
  .words {
    grid-area: words;
  }
  .eyebrow {
    margin-bottom: var(--sp-12);
  }
  .picture {
    grid-area: picture;
    margin-top: var(--sp-20);
  }
  .picture :global(.teaser-compare) {
    height: auto;
    aspect-ratio: 648 / 467;
  }
  .start {
    grid-area: start;
    margin-top: var(--sp-20);
  }
  @media (min-width: 761px) {
    .inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: ". picture" "words picture" "start picture" ". picture";
      column-gap: var(--site-columns-gap);
    }
    .picture {
      margin-top: 0;
    }
    .start {
      justify-self: start;
      margin-top: var(--sp-32);
    }
  }
</style>
