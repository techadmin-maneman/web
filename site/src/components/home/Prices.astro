---
// Published prices: the three-row table, the first-year example and payment,
// all of them the price book's (docs/decisions/0073-prices-from-the-price-book.md).
// The first fit's is the cheapest hair system ops offer, which mm-site's Worker
// writes in; the page is built without one.
import { prices } from "../../content/site.ts";
import { asBuilt, priceTemplate } from "../../lib/prices.ts";
---

<section id="prices" class="container prices" data-section="prices">
  <h2 class="label-title caps">{prices.label}</h2>
  <p class="lead intro">{prices.intro}</p>
  <div class="table" role="table" aria-label={prices.label}>
    <div class="visually-hidden" role="row">
      <div role="columnheader">{prices.label}</div>
      <div role="columnheader">{prices.column}</div>
    </div>
    {prices.rows.map((row) => (
      <div class="row" role="row">
        <div class="what" role="rowheader">
          <div class="name">{row.label}</div>
          <div class="note">{row.note}</div>
        </div>
        <div class="amount" role="cell" data-price={priceTemplate(row.amount)}>
          {asBuilt(row.amount)}
        </div>
      </div>
    ))}
  </div>
  <div class="lines">
    <span data-price={priceTemplate(prices.example)}>{asBuilt(prices.example)}</span>
    <span>{prices.payment}</span>
  </div>
  <div class="actions">
    <a class="btn btn--lg btn--ink book" href="/book">
      {prices.book}
    </a>
    <a class="try" href="/try">
      <span>{prices.tryOn}</span>
    </a>
  </div>
</section>

<style>
  .prices {
    padding-top: var(--prices-pad-top);
  }
  .label-title {
    margin: 0;
    font-weight: var(--weight-regular);
    font-size: var(--fs-16);
    color: var(--text-muted);
  }
  .intro {
    margin: 0 0 var(--intro-gap);
  }
  .table {
    border-top: var(--hairline) solid var(--text);
  }
  /* Each row is its own grid, so the first column may not grow to fit its words: then every row's columns agree,
     and on the narrowest phones a long word breaks rather than pushing the prices off the page. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--price-column);
    align-items: baseline;
    padding: var(--price-row-pad) 0;
    border-bottom: var(--hairline) solid var(--paper-line);
  }
  .what {
    padding-right: var(--sp-16);
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .name {
    font-size: var(--fs-body);
  }
  .note {
    font-size: var(--fs-14);
    color: var(--text-muted);
    margin-top: var(--sp-5);
    line-height: var(--lh-150);
  }
  .amount {
    padding-left: var(--price-cell-pad);
    font-family: var(--font-serif);
    font-size: var(--fs-price);
    line-height: var(--lh-100);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .lines {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-14) var(--sp-48);
    margin-top: var(--sp-28);
    font-size: var(--fs-15);
    color: var(--text-muted);
    line-height: var(--lh-160);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-24) var(--sp-32);
    margin-top: var(--intro-gap);
  }
  .book:hover {
    background: var(--ink-deep);
  }
  .try {
    font-size: var(--fs-16);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .try span {
    border-bottom: var(--hairline) solid var(--paper-line);
    padding-bottom: var(--sp-4);
  }
</style>
