---
// The results beneath the hero, on ink: the specialists' count, then one client's before and after at a time on the
// shared compare (../../islands/ResultsGallery.tsx). The pictures are optimised here, and the island is handed their
// addresses.
import { getImage } from "astro:assets";
import ResultsGallery, { type ShownPair } from "../../islands/ResultsGallery.tsx";
import { resultPairs, results } from "../../content/site.ts";
import { isShown } from "../../lib/build.ts";
import { designImage } from "../../lib/images.ts";

/** The widths the compare is drawn at, at most, once and twice over for a sharp screen. */
const PICTURE_WIDTHS = [520, 1040];
const PICTURE_SIZES = "(min-width: 600px) 540px, 100vw";

const shown = async (file: string, alt: string) => {
  const image = await getImage({ src: designImage(file), format: "webp", widths: PICTURE_WIDTHS });
  return { src: image.src, srcset: image.srcSet.attribute, sizes: PICTURE_SIZES, alt };
};
const pairs: ShownPair[] = await Promise.all(
  resultPairs.pairs.map(async (pair) => ({
    before: await shown(pair.before.file, pair.before.alt),
    after: await shown(pair.after.file, pair.after.alt),
    caption: pair.caption,
    illustration: pair.illustration === true,
  })),
);
---

{isShown(resultPairs) && (
  <section class="results on-ink" data-section="results" aria-label={results.label}>
    <div class="container inner">
      <ResultsGallery client:visible title={results.title} pairs={pairs} />
    </div>
  </section>
)}

<style>
  .results {
    background: var(--ink-deep);
  }
  .inner {
    padding-block: var(--band-pad);
  }
</style>
