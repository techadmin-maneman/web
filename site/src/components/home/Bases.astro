---
// Two bases, two prices: a photograph, v2's cross-section drawing, and four rows.
import { basePhotos, bases, placeholderTag } from "../../content/site.ts";
import { SHOW_PLACEHOLDER_TAGS, isShown } from "../../lib/build.ts";
import DesignPicture from "../DesignPicture.astro";

const showPhotos = isShown(basePhotos);
const { rowLabels } = bases;
---

<section class="container bases" data-section="bases">
  <h2 class="section-title">{bases.title}</h2>
  <div class="grid">
    {bases.kinds.map((kind) => {
      const photo = basePhotos[kind.id];
      return (
        <article class="base">
          <div class="inner">
            <div class="head">
              <h3>{kind.name}</h3>
              <div class="spec">{kind.spec}</div>
            </div>
            {showPhotos && (
              <div class="frame photo">
                <DesignPicture
                  file={photo.file}
                  alt={photo.alt}
                  sizes="(min-width: 761px) 50vw, 100vw"
                  widths={[390, 780, 1200]}
                />
                {SHOW_PLACEHOLDER_TAGS && <div class="label tag">{placeholderTag}</div>}
              </div>
            )}
            <svg
              class="drawing"
              viewBox="0 0 320 176"
              width="100%"
              role="img"
              aria-label={`${kind.name}: ${kind.drawing.tag}, ${kind.drawing.tag2}`}
              fill="none"
              stroke-linecap="round"
            >
              <path class="scalp" d="M14 112 H306" />
              <path class="skin" d="M14 121 H306" />
              <path class="skin" d="M14 130 H306" />
              <path class="membrane" d={kind.drawing.membrane} />
              <path class="detail" d={kind.drawing.detail} stroke-dasharray={kind.drawing.dash} />
              <path class="knots" d={kind.drawing.knots} />
              <path class="hair" d={kind.drawing.hair} />
              <g
                class="words"
                font-family="EB Garamond, serif"
                font-size="13"
                letter-spacing="1.4"
                font-variant="small-caps"
              >
                <text x="14" y="14">
                  {kind.drawing.tag}
                </text>
                <text x="14" y="168">
                  {bases.scalp}
                </text>
                <text x="306" y="168" text-anchor="end">
                  {kind.drawing.tag2}
                </text>
              </g>
            </svg>
            <dl class="rows">
              <dt>{rowLabels.look}</dt>
              <dd>{kind.look}</dd>
              <dt>{rowLabels.breath}</dt>
              <dd>{kind.breath}</dd>
              <dt>{rowLabels.life}</dt>
              <dd>{kind.life}</dd>
              <dt>{rowLabels.price}</dt>
              <dd class="price">{kind.price}</dd>
            </dl>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .bases {
    padding-top: var(--section-gap);
  }
  .section-title {
    margin-bottom: var(--sp-12);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--split-min-mid)), 1fr));
    border-top: var(--hairline) solid var(--text);
  }
  .base {
    padding: var(--base-pad-y) 0;
    border-bottom: var(--hairline) solid var(--paper-line);
  }
  .inner {
    padding: 0 var(--base-pad-x);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-20);
    flex-wrap: wrap;
  }
  h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--fs-base-name);
  }
  .spec {
    font-size: var(--fs-14);
    color: var(--text-muted);
    text-align: right;
    font-variant-numeric: oldstyle-nums;
    line-height: 1.5;
  }
  .photo {
    margin-top: var(--sp-22);
    height: var(--base-photo-h);
  }
  .tag {
    position: absolute;
    top: var(--sp-14);
    left: var(--sp-14);
  }
  .drawing {
    display: block;
    margin-top: var(--sp-20);
    max-height: var(--base-drawing-max);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .scalp {
    stroke: var(--text);
    stroke-width: 1.4;
  }
  .skin {
    stroke: var(--paper-line);
  }
  .membrane {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .detail {
    stroke: var(--text-muted);
    stroke-width: 0.8;
  }
  .knots {
    stroke-width: 1.15;
  }
  .words {
    fill: var(--text-muted);
    stroke: none;
  }
  .rows {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-13) var(--sp-26);
    margin: var(--sp-24) 0 0;
    font-size: var(--fs-16);
    border-top: var(--hairline) solid var(--paper-line);
    padding-top: var(--sp-22);
  }
  dt {
    color: var(--text-muted);
  }
  dd {
    margin: 0;
  }
  .price {
    font-family: var(--font-serif);
    font-size: var(--fs-base-price);
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
</style>
