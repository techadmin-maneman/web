---
// The Norwood scale: stages III–VII, the ones we fit, then a hairline restored. Where the photographs are not
// shown, or content asks for them, the design's line drawings stand in.
import { capsLook } from "@maneman/ui/Caps";
import { buttonLook } from "@maneman/ui/Button";
import { illustrationTag, norwood, norwoodPhotos, norwoodRestored, placeholderTag } from "../../content/site.ts";
import { isShown, isTaggedPlaceholder } from "../../lib/build.ts";
import DesignPicture from "../DesignPicture.astro";

const showPhotos = isShown(norwoodPhotos) && norwoodPhotos.use === "photos";
const sizes = "(min-width: 761px) 210px, 104px";
const widths = [240, 480];

const cards = norwood.stages.map((stage, index) => {
  const photo = norwoodPhotos.images[index];
  if (photo === undefined) throw new Error(`no Norwood photograph for stage ${stage.numeral}`);
  return { stage, photo };
});
---

<section class="norwood" data-section="norwood">
  <div class="container inner">
    <h2 class="section-title">{norwood.title}</h2>
    <p class="lead intro">{norwood.intro}</p>

    <div class={capsLook("group-label")}>{norwood.label}</div>
    <ul class="cards">
      {cards.map(({ stage, photo }) => (
        <li class="card">
          <div class="frame picture">
            {showPhotos ? (
              <DesignPicture file={photo.file} alt={photo.alt} sizes={sizes} widths={widths} class="focus-norwood" />
            ) : (
              <svg class="drawing" viewBox="0 0 96 74" role="img" aria-label={`Norwood ${stage.numeral}`}>
                <path d={stage.bald} />
              </svg>
            )}
            <div class={capsLook("label numeral")}>{stage.numeral}</div>
            {isTaggedPlaceholder(norwoodPhotos) && showPhotos && (
              <div class={capsLook("label placeholder")}>{placeholderTag}</div>
            )}
          </div>
          <div class="head">
            <span class="name">{stage.name}</span>
            <span class={capsLook("tag")}>{stage.tag}</span>
          </div>
        </li>
      ))}
      {isShown(norwoodRestored) && (
        <li class="card restored">
          <div class="frame picture">
            <DesignPicture
              file={norwoodRestored.image.file}
              alt={norwoodRestored.image.alt}
              sizes={sizes}
              widths={widths}
              class="focus-norwood"
            />
            {norwoodRestored.illustration && <div class={capsLook("label placeholder")}>{illustrationTag}</div>}
          </div>
          <div class="head">
            <span class="name">{norwood.restored}</span>
          </div>
        </li>
      )}
    </ul>

    <div class="actions">
      <a class={buttonLook({ variant: "primary", size: "control" })} href="/book">
        {norwood.book}
      </a>
    </div>
  </div>
</section>

<style>
  .norwood {
    margin-top: var(--section-gap);
    background: var(--paper-light);
    border-top: var(--hairline) solid var(--paper-line);
    border-bottom: var(--hairline) solid var(--paper-line);
  }
  .inner {
    padding-block: var(--band-pad);
  }
  .section-title {
    margin-bottom: var(--sp-12);
  }
  .intro {
    margin: 0 0 var(--space-l);
  }
  .group-label {
    margin-bottom: var(--sp-16);
    font-size: var(--fs-16);
    color: var(--ink);
  }
  /* One grid of equal columns, from the left edge: the five stages, then the hairline restored. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--norwood-flow-basis), 1fr));
    gap: var(--space-2xs);
    max-width: var(--norwood-flow-row-max);
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  /*
   * Each card is two rows of the grid (subgrid): picture, then name. Cards side by side share the name row's
   * height, however their names wrap.
   */
  .card {
    background: var(--paper);
    border: var(--hairline) solid var(--paper-line);
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
  }
  .picture {
    grid-row: 1;
    aspect-ratio: 4 / 5;
  }
  .drawing {
    display: block;
    width: 100%;
    height: 100%;
  }
  .drawing path {
    fill: var(--paper);
  }
  .numeral {
    position: absolute;
    top: 0;
    left: 0;
    font-size: var(--fs-14);
  }
  .placeholder {
    position: absolute;
    bottom: 0;
    right: 0;
    padding: var(--sp-4) var(--sp-8);
    letter-spacing: var(--tracking-12);
    color: var(--ink-muted);
  }
  .head {
    grid-row: 2;
    padding: var(--space-2xs);
    border-top: var(--rule-strong) solid var(--ink);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-8);
  }
  .name {
    font-family: var(--font-serif);
    font-size: var(--fs-lead);
    line-height: var(--lh-115);
    text-wrap: pretty;
  }
  .tag {
    letter-spacing: var(--tracking-12);
    font-size: var(--fs-13);
    white-space: nowrap;
    color: var(--ink);
  }
  /* The hairline restored: the card the five lead to, on ink. */
  .restored {
    background: var(--ink);
    border-color: var(--ink);
  }
  .restored .head {
    border-top-color: var(--paper);
  }
  .restored .name {
    color: var(--paper);
  }
  /*
   * A phone: one card a row, its picture beside its words, so names and tags keep to a line.
   */
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .card {
      grid-row: auto;
      grid-template-columns: var(--norwood-thumb) minmax(0, 1fr);
      grid-template-rows: auto;
    }
    .picture {
      grid-row: 1;
      border-right: var(--rule-strong) solid var(--ink);
    }
    .restored .picture {
      border-right-color: var(--paper);
    }
    .head {
      grid-row: 1;
      border-top: 0;
      flex-wrap: wrap;
      align-self: center;
      row-gap: var(--sp-4);
    }
  }
  .actions {
    margin-top: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-16) var(--sp-32);
    align-items: center;
  }
</style>
