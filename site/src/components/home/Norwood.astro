---
// The Norwood scale, on white (ADR 0263): stages III–VII, the ones we fit, then a hairline restored. A laptop shows the
// six in one row beneath the heading and the way to book; a phone chooses a stage above two pictures
// (../../islands/home/NorwoodPicker.tsx). Where the photographs are not shown, the design's line drawings stand in.
import { getImage } from "astro:assets";
import { buttonLook } from "@maneman/ui/Button";
import NorwoodPicker, { type PickerPicture } from "../../islands/home/NorwoodPicker.tsx";
import {
  illustrationTag,
  norwood,
  norwoodPhotos,
  norwoodRestored,
  placeholderTag,
  results,
} from "../../content/site.ts";
import { isShown, isTaggedPlaceholder } from "../../lib/build.ts";
import { designImage } from "../../lib/images.ts";
import DesignPicture from "../DesignPicture.astro";

const showPhotos = isShown(norwoodPhotos) && norwoodPhotos.use === "photos";
const showRestored = isShown(norwoodRestored);
const sizes = "(min-width: 761px) 190px, 50vw";
const widths = [240, 480];

const picture = async (file: string, alt: string): Promise<PickerPicture> => {
  const image = await getImage({ src: designImage(file), format: "webp", widths });
  return { src: image.src, srcset: image.srcSet.attribute, sizes, alt };
};

const cards = norwood.stages.map((stage, index) => {
  const photo = norwoodPhotos.images[index];
  if (photo === undefined) throw new Error(`no Norwood photograph for stage ${stage.numeral}`);
  return { stage, photo };
});
const pickerStages = showPhotos
  ? await Promise.all(
      cards.map(async ({ stage, photo }) => ({ ...stage, picture: await picture(photo.file, photo.alt) })),
    )
  : [];
const restoredPicture = showRestored ? await picture(norwoodRestored.image.file, norwoodRestored.image.alt) : null;
---

<section class="band ground-white" data-section="norwood">
  <div class="container">
    <div class="head">
      <div>
        <h2 class="section-title">{norwood.title}</h2>
        <p class="lead">{norwood.intro}</p>
        <p class="stages">{norwood.label}</p>
      </div>
      <a class={buttonLook({ variant: "primary", size: "action", className: "book wide" })} href="/book" data-filled>
        {norwood.book}
      </a>
    </div>

    <ul class:list={["row", showPhotos && "wide"]}>
      {cards.map(({ stage, photo }) => (
        <li>
          <figure class="tile">
            <div class="frame picture">
              {showPhotos ? (
                <DesignPicture file={photo.file} alt={photo.alt} sizes={sizes} widths={widths} />
              ) : (
                <svg class="drawing" viewBox="0 0 96 74" role="img" aria-label={`Norwood ${stage.numeral}`}>
                  <path d={stage.bald} />
                </svg>
              )}
              <span class="label numeral">{stage.numeral}</span>
              {isTaggedPlaceholder(norwoodPhotos) && showPhotos && (
                <span class="label placeholder">{placeholderTag}</span>
              )}
            </div>
            <figcaption class="caption">
              <span class="name">{stage.name}</span>
              <span class="sub">{stage.tag}</span>
            </figcaption>
          </figure>
        </li>
      ))}
      {showRestored && (
        <li>
          <figure class="tile">
            <div class="frame picture restored">
              <DesignPicture
                file={norwoodRestored.image.file}
                alt={norwoodRestored.image.alt}
                sizes={sizes}
                widths={widths}
              />
              <span class="label numeral">{results.after}</span>
            </div>
            <figcaption class="caption">
              <span class="name">{norwood.restored}</span>
              {norwoodRestored.illustration && <span class="sub">{illustrationTag}</span>}
            </figcaption>
          </figure>
        </li>
      )}
    </ul>

    {showPhotos && (
      <div class="phone">
        <NorwoodPicker
          client:media="(max-width: 760px)"
          stages={pickerStages}
          restored={restoredPicture}
          illustration={norwoodRestored.illustration}
          placeholder={isTaggedPlaceholder(norwoodPhotos) ? placeholderTag : null}
        />
      </div>
    )}

    <a class={buttonLook({ variant: "primary", size: "action", className: "book narrow" })} href="/book" data-filled>
      {norwood.book}
    </a>
  </div>
</section>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-40);
  }
  .stages {
    margin: var(--sp-12) 0 0;
    font-size: var(--site-fs-label);
    font-weight: var(--weight-semibold);
    color: var(--site-text-muted);
  }
  /* Two to a row on a phone, where the drawings stand in for the photographs; six on a laptop. */
  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-16);
    margin: var(--site-gap-list) 0 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    margin: 0;
  }
  .picture {
    aspect-ratio: 204 / 255;
    background: var(--site-band);
  }
  .restored {
    background: var(--site-navy);
  }
  .picture :global(img) {
    object-position: 50% 30%;
  }
  .drawing {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--site-text-muted);
  }
  .numeral {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--site-numeral-w);
    height: var(--site-numeral-h);
  }
  .placeholder {
    position: absolute;
    left: 0;
    bottom: 0;
  }
  .caption {
    display: flex;
    flex-direction: column;
    padding-top: var(--sp-12);
  }
  .name {
    font-size: var(--site-fs-body);
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  .sub {
    font-size: var(--site-fs-label);
    color: var(--site-text-muted);
  }
  .narrow {
    margin-top: var(--sp-24);
  }

  /* A phone chooses a stage; a laptop shows the row, with the way to book beside the heading. */
  @media (max-width: 760px) {
    .wide {
      display: none;
    }
  }
  @media (min-width: 761px) {
    .row {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .phone,
    .narrow {
      display: none;
    }
  }
</style>
