---
// The hero: muted looping footage behind the headline. The poster is the
// largest thing painted first, so it is an image of its own, fetched first, and
// a phone's is the upright centre its own cut of the film opens on; the video,
// over it, fetches nothing until it plays, once the page has loaded.
// Over it the opening line shows one phrase at a time, round and round,
// until Pause stops it with the film; a screen reader hears the whole line
// once, and reduced motion shows the last phrase alone.
import { capsLook } from "@maneman/ui/Caps";
import { buttonLook } from "@maneman/ui/Button";
import { hero, heroFootage } from "../../content/site.ts";
import { isShown, isTaggedPlaceholder } from "../../lib/build.ts";
import { PHONE_SCREEN } from "../../lib/hero-film.ts";
import { heroPosters, PHONE_POSTER } from "../../lib/hero.ts";
import { designMedia } from "../../lib/images.ts";

const posters = await heroPosters();
const showFootage = isShown(heroFootage);
---

<section class="hero on-ink" data-section="hero">
  {showFootage && posters !== undefined && (
    <div class="footage">
      <picture>
        <source media={PHONE_SCREEN} srcset={posters.phone} width={PHONE_POSTER.width} height={PHONE_POSTER.height} />
        <img class="poster" src={posters.wide} alt="" width="1440" height="810" fetchpriority="high" />
      </picture>
      <video
        data-hero-video
        data-film={designMedia(heroFootage.video)}
        data-phone-film={designMedia(heroFootage.phoneVideo)}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      />
    </div>
  )}
  <div class="scrim"></div>
  <div class="scrim scrim--up"></div>
  <div class="scrim scrim--side"></div>
  {isTaggedPlaceholder(heroFootage) && showFootage && <div class={capsLook("label tag")}>{heroFootage.tag}</div>}
  <button
    type="button"
    class={buttonLook({ variant: "outlineOnInk", size: "small", className: "strong pause" })}
    data-hero-toggle
    data-pause={hero.pause}
    data-play={hero.play}
  >
    {hero.pause}
  </button>
  <div class="content">
    <p class="sequence">
      {hero.sequence.map((phrase, index) => (
        <span class:list={["phrase", { on: index === 0 }]} data-phrase>
          {phrase}{" "}
        </span>
      ))}
    </p>
    <h1>{hero.title}</h1>
    <p class="body">{hero.body}</p>
    <div class="actions">
      <a class={buttonLook({ variant: "light", size: "action" })} href="/try">
        {hero.tryOn}
      </a>
      <a class={buttonLook({ variant: "outlineOnInk", size: "action", className: "strong" })} href="/book">
        {hero.book}
      </a>
    </div>
  </div>
</section>

<script>
  // Turns the opening line unless the visitor asked for reduced motion or
  // pressed Pause (WCAG 2.2.2), and plays the footage too unless they asked for
  // less data or are on a slow connection; Play starts both whatever the
  // reason. The film's address is set only when it first plays, after the page
  // has loaded, so until then nothing of it is fetched. Browsers pause media in
  // a background tab, so it is resumed when the tab returns. Reduced motion
  // shows the last phrase.
  import { type Connection, milliseconds, PHONE_SCREEN, playsByItself } from "../../lib/hero-film.ts";

  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-hero-toggle]");
  const phrases = [...document.querySelectorAll<HTMLElement>("[data-phrase]")];
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const connection = (navigator as Navigator & { connection?: Connection }).connection;
  const line = document.querySelector<HTMLElement>(".sequence");
  const holdMs = line === null ? 0 : milliseconds(getComputedStyle(line).getPropertyValue("--hold"));
  let stopped = reduced.matches;
  let filmByItself = playsByItself(reduced.matches, connection);
  let shown = 0;
  let turning: number | undefined;

  const show = (index: number) => {
    shown = index;
    phrases.forEach((phrase, at) => phrase.classList.toggle("on", at === index));
  };
  const turn = () => {
    window.clearInterval(turning);
    turning = undefined;
    if (stopped || !(holdMs > 0)) return;
    turning = window.setInterval(() => {
      show((shown + 1) % phrases.length);
    }, holdMs);
  };
  const label = () => {
    if (toggle === null) return;
    toggle.textContent = (stopped ? toggle.dataset.play : toggle.dataset.pause) ?? "";
  };
  const load = (film: HTMLVideoElement) => {
    if (film.hasAttribute("src")) return;
    const phone = window.matchMedia(PHONE_SCREEN).matches;
    film.src = (phone ? film.dataset.phoneFilm : film.dataset.film) ?? "";
  };
  const play = () => {
    if (video === null || stopped || !filmByItself || document.hidden) return;
    load(video);
    video.play().catch(() => undefined);
  };
  const stopOrStart = (stop: boolean) => {
    stopped = stop;
    label();
    turn();
    if (stop) video?.pause();
    else play();
  };

  if (reduced.matches) show(phrases.length - 1);
  turn();

  label();
  if (document.readyState === "complete") play();
  else window.addEventListener("load", play, { once: true });
  document.addEventListener("visibilitychange", play);
  reduced.addEventListener("change", () => {
    filmByItself = playsByItself(reduced.matches, connection);
    stopOrStart(reduced.matches);
  });
  toggle?.addEventListener("click", () => {
    // Play asks for the film as well as the line.
    if (stopped) filmByItself = true;
    stopOrStart(!stopped);
  });
</script>

<style>
  .hero {
    position: relative;
    background: var(--ink-deep);
    overflow: hidden;
    min-height: var(--hero-min-h);
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--bar-reserve);
  }
  .footage {
    position: absolute;
    inset: 0;
    background: var(--ink-night);
  }
  .poster,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scaleX(-1);
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: var(--hero-scrim);
  }
  .scrim--up {
    background: var(--hero-scrim-up);
  }
  .scrim--side {
    background: var(--hero-scrim-side);
  }
  .tag {
    position: absolute;
    top: var(--hero-tag-top);
    left: var(--gutter);
    padding: var(--sp-8) var(--sp-12);
    font-size: var(--fs-14);
  }
  /* The way to stop the footage (WCAG 2.2.2), at the corner the placeholder tag leaves free (ADR 0022). */
  .pause {
    position: absolute;
    z-index: var(--z-raised);
    top: var(--hero-tag-top);
    right: var(--gutter);
  }
  .content {
    position: relative;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-2xl);
  }
  /* The phrases share one cell, so the line keeps the height of its longest and nothing below it moves. */
  .sequence {
    /* How long each phrase shows, which the script reads. */
    --hold: var(--duration-phrase);
    display: grid;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-hero-line);
    line-height: var(--lh-100);
    letter-spacing: var(--tracking-display);
    color: var(--paper);
    max-width: var(--measure-hero);
  }
  .phrase {
    grid-area: 1 / 1;
    opacity: 0;
    text-wrap: balance;
    transition: opacity var(--duration-travel) var(--ease-house);
  }
  .phrase.on {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .phrase {
      transition: none;
    }
  }
  h1 {
    margin: var(--space-xs) 0 0;
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: var(--fs-h4);
    line-height: var(--lh-115);
    letter-spacing: var(--tracking-heading);
    color: var(--paper);
    max-width: var(--measure-hero);
    text-wrap: balance;
  }
  .body {
    margin: var(--sp-16) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-160);
    color: var(--ink-tag);
    max-width: var(--measure-hero-body);
    text-wrap: pretty;
  }
  /* On a phone the two stack at one width; on a wider screen they sit side by side at their own. */
  @media (max-width: 760px) {
    .actions > :global(*) {
      flex: 1 1 100%;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-16);
    margin-top: var(--space-s);
  }
  /* Over the film, the outlines' edge is the stronger line. */
  .strong {
    --edge-on-ink: var(--ink-line-strong);
  }
</style>
