---
// The hero: muted looping footage behind the headline. The poster is the
// largest thing painted first, so it is preloaded; the video fetches only its
// metadata until it plays, once the page has loaded, and never plays for
// reduced motion. Over it the opening line shows one phrase at a time, once,
// and settles on the last; a screen reader hears the whole line once, and
// reduced motion shows the last phrase alone.
import { hero, heroFootage } from "../../content/site.ts";
import { SHOW_PLACEHOLDER_TAGS, isShown } from "../../lib/build.ts";
import { designMedia } from "../../lib/images.ts";

interface Props {
  /** The poster's URL, which the page also preloads (src/lib/hero.ts). */
  poster: string | undefined;
}

const { poster } = Astro.props;
const showFootage = isShown(heroFootage);
---

<section class="hero on-ink" data-section="hero">
  {showFootage && poster !== undefined && (
    <div class="footage">
      <video
        data-hero-video
        src={designMedia(heroFootage.video)}
        poster={poster}
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      />
    </div>
  )}
  <div class="scrim"></div>
  <div class="scrim scrim--up"></div>
  <div class="scrim scrim--side"></div>
  {SHOW_PLACEHOLDER_TAGS && showFootage && <div class="label tag">{heroFootage.tag}</div>}
  {showFootage && poster !== undefined && (
    <button
      type="button"
      class="btn btn--sm btn--line-on-ink strong pause"
      data-hero-toggle
      data-pause={hero.pause}
      data-play={hero.play}
    >
      {hero.pause}
    </button>
  )}
  <div class="content">
    <p class="sequence">
      {hero.sequence.map((phrase) => (
        <span class="phrase">{phrase} </span>
      ))}
    </p>
    <h1>{hero.title}</h1>
    <p class="body">{hero.body}</p>
    <div class="actions">
      <a class="btn btn--lg btn--paper" href="/try">
        {hero.tryOn}
      </a>
      <a class="btn btn--lg btn--line-on-ink strong" href="/book">
        {hero.book}
      </a>
    </div>
  </div>
</section>

<script>
  // Plays the footage unless the visitor asked for reduced motion or pressed
  // Pause (WCAG 2.2.2). It waits for the page to load, so its download never
  // slows the poster or the fonts. Browsers pause media in a background tab,
  // so it is resumed when the tab returns.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-hero-toggle]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  let stopped = reduced.matches;

  const label = () => {
    if (toggle === null) return;
    toggle.textContent = (stopped ? toggle.dataset.play : toggle.dataset.pause) ?? "";
  };
  const play = () => {
    if (video === null || stopped || document.hidden) return;
    video.play().catch(() => undefined);
  };
  const stopOrStart = (stop: boolean) => {
    stopped = stop;
    label();
    if (stop) video?.pause();
    else play();
  };

  label();
  if (document.readyState === "complete") play();
  else window.addEventListener("load", play, { once: true });
  document.addEventListener("visibilitychange", play);
  reduced.addEventListener("change", () => {
    stopOrStart(reduced.matches);
  });
  toggle?.addEventListener("click", () => {
    stopOrStart(!stopped);
  });
</script>

<style>
  .hero {
    position: relative;
    background: var(--ink-deep);
    overflow: hidden;
    min-height: var(--hero-min-h);
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--bar-reserve);
  }
  .footage {
    position: absolute;
    inset: 0;
    background: var(--ink-night);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scaleX(-1);
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: var(--hero-scrim);
  }
  .scrim--up {
    background: var(--hero-scrim-up);
  }
  .scrim--side {
    background: var(--hero-scrim-side);
  }
  .tag {
    position: absolute;
    top: var(--hero-tag-top);
    left: var(--gutter);
    padding: var(--sp-7) var(--sp-12);
    font-size: var(--fs-14);
  }
  /* Not in v2: the way to stop the footage, at the corner the placeholder tag leaves free (ADR 0022, item 37). */
  .pause {
    position: absolute;
    z-index: 1;
    top: var(--hero-tag-top);
    right: var(--gutter);
  }
  .content {
    position: relative;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter) var(--hero-pad-bottom);
  }
  /* The phrases share one cell, so the line keeps the height of its longest and nothing below it moves. */
  .sequence {
    display: grid;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-hero);
    line-height: var(--lh-97);
    letter-spacing: var(--tracking-display);
    color: var(--paper);
    max-width: var(--measure-hero);
  }
  .phrase {
    grid-area: 1 / 1;
    opacity: 0;
    text-wrap: balance;
    animation: phrase var(--duration-phrase) var(--ease-house) both;
  }
  .phrase:nth-child(2) {
    animation-delay: var(--duration-phrase);
  }
  .phrase:nth-child(3) {
    animation-delay: calc(2 * var(--duration-phrase));
  }
  .phrase:last-child {
    opacity: 1;
    animation: settle var(--duration-quick) var(--ease-house) both;
    animation-delay: calc(3 * var(--duration-phrase));
  }
  @keyframes phrase {
    0%,
    100% {
      opacity: 0;
    }
    25%,
    75% {
      opacity: 1;
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .phrase,
    .phrase:last-child {
      animation: none;
    }
  }
  h1 {
    margin: var(--hero-body-gap) 0 0;
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: var(--fs-hero-title);
    line-height: var(--lh-115);
    letter-spacing: var(--tracking-heading);
    color: var(--paper);
    max-width: var(--measure-hero);
    text-wrap: balance;
  }
  .body {
    margin: var(--sp-16) 0 0;
    font-size: var(--fs-hero-body);
    line-height: var(--lh-155);
    color: var(--ink-tag);
    max-width: var(--measure-hero-body);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-14);
    margin-top: var(--hero-actions-gap);
  }
  .strong,
  .strong:hover {
    border-color: var(--ink-line-strong);
  }
  .strong:hover {
    border-color: var(--paper);
  }
</style>
