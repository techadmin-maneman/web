---
// Why choose a hair system: against a transplant and medication.
import CompareTable from "../CompareTable.astro";
import { comparison } from "../../content/site.ts";
---

<section class="container comparison" data-section="comparison">
  <h2 class="section-title">{comparison.title}</h2>
  <p class="lead intro">{comparison.intro}</p>
  <CompareTable
    label={comparison.title}
    columns={comparison.columns}
    rows={comparison.rows}
    yes={comparison.yes}
    no={comparison.no}
  />
</section>

<style>
  .comparison {
    padding-top: var(--section-gap);
  }
  .section-title {
    margin-bottom: var(--sp-12);
  }
  .intro {
    margin: 0 0 var(--space-l);
  }
</style>
