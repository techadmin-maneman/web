---
// How it works, on white (ADR 0263): three numbered steps, each with a photograph, then the line that the visit stays
// at your own table, which closes the section under a navy rule on a phone.
import { capsLook } from "@maneman/ui/Caps";
import { discretionBand, howItWorks, placeholderTag, stepPhotos } from "../../content/site.ts";
import { isShown, isTaggedPlaceholder } from "../../lib/build.ts";
import DesignPicture from "../DesignPicture.astro";

const showPhotos = isShown(stepPhotos);
const steps = howItWorks.steps.map((step, index) => ({ ...step, photo: stepPhotos.images[index] }));
---

<section class="band ground-white" data-section="how">
  <div class="container">
    <h2 class="section-title">{howItWorks.title}</h2>
    <ol class="steps">
      {steps.map((step) => (
        <li class="step">
          <div class="text">
            <span class="number" aria-hidden="true">
              {step.number}
            </span>
            <div>
              <h3 class="title">{step.title}</h3>
              <p class="body-text body">{step.body}</p>
              <p class="meta">{step.meta}</p>
            </div>
          </div>
          {showPhotos && step.photo !== undefined && (
            <div class="frame photo">
              <DesignPicture
                file={step.photo.file}
                alt={step.photo.alt}
                sizes="(min-width: 761px) 380px, 100vw"
                widths={[390, 780]}
              />
              {isTaggedPlaceholder(stepPhotos) && <div class={capsLook("label tag")}>{placeholderTag}</div>}
            </div>
          )}
        </li>
      ))}
    </ol>
    <p class="statement table-line">{discretionBand.text}</p>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    display: flex;
    flex-direction: column;
    margin-top: var(--sp-24);
    padding-top: var(--sp-24);
    border-top: var(--hairline) solid var(--site-line);
  }
  /* A phone shows the picture first. */
  .photo {
    order: -1;
    aspect-ratio: 644 / 480;
    background: var(--site-band);
  }
  .text {
    display: flex;
    gap: var(--sp-12);
    margin-top: var(--sp-16);
  }
  .number,
  .title {
    margin: 0;
    font-size: var(--site-fs-caption);
    font-weight: var(--weight-semibold);
    color: var(--site-navy);
  }
  .number {
    flex: 0 0 var(--sp-28);
  }
  .body {
    margin-top: var(--sp-8);
  }
  .meta {
    margin: var(--sp-8) 0 0;
    font-size: var(--site-fs-label);
    color: var(--site-text-muted);
  }
  .table-line {
    margin-top: var(--site-space-32-56);
    padding-top: var(--sp-24);
    font-size: var(--site-fs-statement-how);
    line-height: var(--lh-125);
    letter-spacing: var(--site-tracking-statement);
  }
  @media (min-width: 761px) {
    .steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-32);
      margin-top: var(--sp-40);
    }
    .step {
      margin-top: 0;
      padding-top: var(--sp-20);
      border-top: var(--rule-strong) solid var(--site-navy);
    }
    .photo {
      order: 0;
    }
    .text {
      align-items: baseline;
      margin: 0 0 var(--sp-16);
    }
    .number {
      flex: none;
    }
    .body {
      min-height: var(--site-step-body-min);
    }
    .table-line {
      max-width: var(--site-statement-max);
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
