---
// The footer, on every page but the flows, /book, the referral landing and /try, which each end in themselves (ADR
// 0265; ADR 0326): navy under a navy-700 rule (ADR 0263), the lockup, its line and the number on the left, the links
// in columns beside them, each city served among them; then the company, its notices and the area. It has no Book:
// a page's own call to book is above it.
import { capsLook } from "@maneman/ui/Caps";
import { textLinkLook } from "@maneman/ui/TextLink";
import { areasPage } from "../content/guides.ts";
import { business, consentBar, footer, whatsapp } from "../content/site.ts";
import { CONSENT_BAR_SHOWN } from "../lib/flags.ts";
import { isShown } from "../lib/build.ts";
import { citySlug } from "../lib/cities.ts";
import { MORE_PAGES } from "../lib/more-pages.ts";
import { sectionHref } from "../lib/page-path.ts";
import { SERVED_CITIES } from "../lib/served-cities.ts";
import { whatsappChat } from "@maneman/web-kit/whatsapp";
import Icon from "./Icon.astro";
import Lockup from "./Lockup.astro";
import Social from "./Social.astro";

interface Props {
  /** The home page's sections this page has of its own (../layouts/Site.astro). */
  sections?: readonly string[];
  /** The page has the sticky bar at a phone's foot, which the footer keeps room for, and a band just above it. */
  bar?: boolean;
}

const { sections = [], bar = false } = Astro.props;
const { service, areas, more, reach, legal } = footer.columns;
const showAreas = isShown(areasPage) && SERVED_CITIES.length > 0;
// The number is given as WhatsApp alone: the footer offers no line to call.
const showWhatsapp = isShown(whatsapp);
const year = new Date().getFullYear();
---

<footer class:list={["footer", { "with-bar": bar }]}>
  <div class="inner">
    <div class="top">
      <div class="brand">
        <a class={textLinkLook({ tone: "ink", quiet: true, className: "home" })} href="/" aria-label={business.name}>
          <Lockup size="footer" tone="white" />
        </a>
        <p class="tagline">{footer.tagline}</p>
        {showWhatsapp && (
          <div class="reach">
            <span class={capsLook("title")}>{reach.title}</span>
            <a
              class={textLinkLook({ tone: "ink", quiet: true, className: "item number" })}
              href={whatsappChat(whatsapp.number)}
              aria-label={whatsapp.label}
            >
              <Icon name="whatsapp" size="sm" />
              {whatsapp.display}
            </a>
          </div>
        )}
      </div>
      <nav class="columns" aria-label={footer.pagesLabel}>
        <div class="column">
          <span class={capsLook("title")}>{service.title}</span>
          {service.links.map((link) => (
            <a
              class={textLinkLook({ tone: "ink", quiet: true, className: "item" })}
              href={sectionHref(link.href, sections)}
            >
              {link.label}
            </a>
          ))}
        </div>
        {showAreas && (
          <div class="column">
            <span class={capsLook("title")}>{areas.title}</span>
            {/* Each names its city, so the Worker leaves out one no longer served (site/src/worker.ts). */}
            {SERVED_CITIES.map((city) => (
              <a
                class={textLinkLook({ tone: "ink", quiet: true, className: "item" })}
                href={`/areas/${citySlug(city)}`}
                data-city={city}
              >
                {city}
              </a>
            ))}
            <a class={textLinkLook({ tone: "ink", quiet: true, className: "item" })} href="/areas">
              {areas.all}
            </a>
          </div>
        )}
        {MORE_PAGES.length > 0 && (
          <div class="column">
            <span class={capsLook("title")}>{more.title}</span>
            {MORE_PAGES.map((link) => (
              <a class={textLinkLook({ tone: "ink", quiet: true, className: "item" })} href={link.href}>
                {link.label}
              </a>
            ))}
          </div>
        )}
      </nav>
    </div>
    <div class="bottom">
      <nav class="legal" aria-label={legal.title}>
        <span class="quiet">{`${footer.copyright} ${String(year)} ${footer.entity}`}</span>
        {legal.links.map((link) => (
          <a class={textLinkLook({ tone: "ink", quiet: true, className: "item small" })} href={link.href}>
            {link.label}
          </a>
        ))}
        {CONSENT_BAR_SHOWN && (
          <button
            type="button"
            class={textLinkLook({ tone: "ink", quiet: true, className: "item small" })}
            data-cookie-choices
          >
            {consentBar.change}
          </button>
        )}
      </nav>
      <span class="quiet area">{footer.area}</span>
      <Social />
    </div>
  </div>
</footer>

<style>
  /* Below a page's words, a gap first; below a band, none. */
  .footer {
    margin-top: var(--site-foot-gap);
    background: var(--site-navy);
    border-top: var(--hairline) solid var(--site-navy-rule);
    color: var(--site-on-navy);
  }
  .with-bar {
    margin-top: 0;
  }
  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sp-40) var(--gutter) calc(var(--sp-40) + var(--consent-reserve));
  }
  /* Room for the sticky bar at a phone's foot, so it never covers the last line. */
  .with-bar .inner {
    padding-bottom: calc(var(--bar-h) + var(--sp-40) + var(--consent-reserve));
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-28);
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .home {
    display: flex;
  }
  .tagline {
    margin: var(--sp-16) 0 0;
    max-width: var(--measure-short);
    font-size: var(--fs-16);
    line-height: var(--lh-130);
  }
  .reach {
    display: flex;
    flex-direction: column;
    margin-top: var(--sp-28);
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-24);
    align-content: start;
  }
  .column {
    display: flex;
    flex-direction: column;
  }
  .title {
    font-size: var(--fs-14);
    color: var(--site-on-navy-muted);
  }
  .item {
    font-size: var(--fs-16);
    color: var(--site-on-navy);
  }
  /* WhatsApp's mark beside the number, as the sticky bar draws it. */
  .number {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    font-variant-numeric: tabular-nums;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--sp-16);
    margin-top: var(--sp-28);
    padding-top: var(--sp-8);
    border-top: var(--hairline) solid var(--site-navy-rule);
    font-size: var(--fs-14);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--sp-16);
  }
  .small {
    font-size: var(--fs-14);
  }
  .quiet {
    color: var(--site-on-navy-muted);
  }
  .area {
    flex-basis: 100%;
    padding-top: var(--sp-8);
  }

  @media (min-width: 761px) {
    .inner,
    .with-bar .inner {
      padding: var(--sp-64) var(--gutter) calc(var(--sp-48) + var(--consent-reserve));
    }
    .top {
      grid-template-columns: minmax(0, 2fr) minmax(0, 2fr);
      gap: var(--sp-40);
    }
    .tagline {
      margin-top: var(--sp-20);
      max-width: var(--measure-button-column);
      font-size: var(--fs-24);
      line-height: var(--lh-130);
    }
    .reach {
      margin-top: var(--sp-32);
    }
    /* One column for each list, side by side. */
    .columns {
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      gap: var(--sp-40);
    }
    .bottom {
      gap: 0 var(--sp-24);
      margin-top: var(--sp-48);
      padding-top: var(--sp-12);
    }
    .area {
      flex-basis: auto;
      margin-left: auto;
      padding-top: 0;
    }
  }
</style>
