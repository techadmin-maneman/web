---
// The footer, on the home page only, navy under a navy-700 rule (ADR 0263): the lockup, its line and the number on the
// left, the links in two columns beside them; then the company, its notices and the area. It has no Book: the
// closing band above it is the last call.
import { capsLook } from "@maneman/ui/Caps";
import { textLinkLook } from "@maneman/ui/TextLink";
import { business, footer, whatsapp } from "../content/site.ts";
import { isShown } from "../lib/build.ts";
import { MORE_PAGES } from "../lib/more-pages.ts";
import { whatsappChat } from "@maneman/web-kit/whatsapp";
import Lockup from "./Lockup.astro";
import Social from "./Social.astro";

const { service, more, reach, legal } = footer.columns;
// The number is given as WhatsApp alone: the footer offers no line to call.
const showWhatsapp = isShown(whatsapp);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <div class="top">
      <div class="brand">
        <a class="home" href="/" aria-label={business.name}>
          <Lockup size="footer" tone="white" />
        </a>
        <p class="tagline">{footer.tagline}</p>
        {showWhatsapp && (
          <div class="reach">
            <span class={capsLook("title")}>{reach.title}</span>
            <a
              class={textLinkLook({ tone: "ink", quiet: true, className: "item number" })}
              href={whatsappChat(whatsapp.number)}
            >
              {whatsapp.label}
            </a>
          </div>
        )}
      </div>
      <nav class="columns" aria-label={footer.pagesLabel}>
        <div class="column">
          <span class={capsLook("title")}>{service.title}</span>
          {service.links.map((link) => (
            <a class={textLinkLook({ tone: "ink", quiet: true, className: "item" })} href={link.href}>
              {link.label}
            </a>
          ))}
        </div>
        {MORE_PAGES.length > 0 && (
          <div class="column">
            <span class={capsLook("title")}>{more.title}</span>
            {MORE_PAGES.map((link) => (
              <a class={textLinkLook({ tone: "ink", quiet: true, className: "item" })} href={link.href}>
                {link.label}
              </a>
            ))}
          </div>
        )}
      </nav>
    </div>
    <div class="bottom">
      <nav class="legal" aria-label={legal.title}>
        <span class="quiet">{`${footer.copyright} ${String(year)} ${footer.entity}`}</span>
        {legal.links.map((link) => (
          <a class={textLinkLook({ tone: "ink", quiet: true, className: "item small" })} href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>
      <span class="quiet area">{footer.area}</span>
      <Social />
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--site-navy);
    border-top: var(--hairline) solid var(--site-navy-rule);
    color: var(--site-on-navy);
  }
  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sp-40) var(--gutter) calc(var(--bar-h) + var(--sp-40));
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-28);
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .home {
    display: flex;
  }
  .tagline {
    margin: var(--sp-16) 0 0;
    max-width: var(--measure-short);
    font-size: var(--fs-16);
    line-height: var(--lh-130);
  }
  .reach {
    display: flex;
    flex-direction: column;
    margin-top: var(--sp-28);
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-24);
    align-content: start;
  }
  .column {
    display: flex;
    flex-direction: column;
  }
  .title {
    font-size: var(--fs-14);
    color: var(--site-on-navy-muted);
  }
  .item {
    font-size: var(--fs-16);
    color: var(--site-on-navy);
  }
  .number {
    font-variant-numeric: tabular-nums;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--sp-16);
    margin-top: var(--sp-28);
    padding-top: var(--sp-8);
    border-top: var(--hairline) solid var(--site-navy-rule);
    font-size: var(--fs-14);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--sp-16);
  }
  .small {
    font-size: var(--fs-14);
  }
  .quiet {
    color: var(--site-on-navy-muted);
  }
  .area {
    flex-basis: 100%;
    padding-top: var(--sp-8);
  }

  @media (min-width: 761px) {
    .inner {
      padding: var(--sp-64) var(--gutter) var(--sp-48);
    }
    .top {
      grid-template-columns: minmax(0, 2fr) minmax(0, 2fr);
      gap: var(--sp-40);
    }
    .tagline {
      margin-top: var(--sp-20);
      max-width: var(--measure-button-column);
      font-size: var(--fs-24);
      line-height: var(--lh-130);
    }
    .reach {
      margin-top: var(--sp-32);
    }
    .columns {
      gap: var(--sp-40);
    }
    .bottom {
      gap: 0 var(--sp-24);
      margin-top: var(--sp-48);
      padding-top: var(--sp-12);
    }
    .area {
      flex-basis: auto;
      margin-left: auto;
      padding-top: 0;
    }
  }
</style>
