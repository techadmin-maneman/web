---
// The foot of every page but the home page, which has the full footer: the company, and its privacy notice and terms,
// so every page that takes a person's details links both.
import { textLinkLook } from "@maneman/ui/TextLink";
import { footer } from "../content/site.ts";

const { legal } = footer.columns;
---

<footer class="legal">
  <span>{footer.entity}</span>
  {legal.links.map((link) => (
    <a class={textLinkLook({ tone: "brass", quiet: true })} href={link.href}>
      {link.label}
    </a>
  ))}
</footer>

<style>
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-8) var(--sp-24);
    max-width: var(--page-max);
    margin: var(--section-gap) auto 0;
    padding: var(--sp-24) var(--gutter) var(--sp-32);
    border-top: var(--hairline) solid var(--paper-line);
    font-size: var(--fs-14);
    color: var(--text-muted);
  }
</style>
