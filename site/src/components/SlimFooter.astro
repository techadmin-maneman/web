---
// The foot of every page but the home page, which has the full footer: navy, the lockup in white and where to go from
// here, then the company and its privacy notice and terms under a navy-700 rule, so every page that takes a person's
// details links both. A laptop's /try draws none, the flow ending in itself (ADR 0265), and /book and the referral
// landing draw none at all (layouts/Site.astro); their consent lines link the notices and the terms.
import { textLinkLook } from "@maneman/ui/TextLink";
import { business, footer } from "../content/site.ts";
import { MORE_PAGES } from "../lib/more-pages.ts";
import { isFlowPage, pagePath } from "../lib/page-path.ts";
import Lockup from "./Lockup.astro";
import Social from "./Social.astro";

const { legal } = footer.columns;
const year = new Date().getFullYear();
const flow = isFlowPage(pagePath(Astro.url.pathname));
---

<footer class:list={["slim", flow && "flow"]}>
  <div class="inner">
    <div class="top">
      <a class={textLinkLook({ tone: "ink", quiet: true, className: "home" })} href="/" aria-label={business.name}>
        <Lockup size="slim" tone="white" />
      </a>
      <nav class="pages" aria-label={footer.pagesLabel}>
        {[...footer.pages, ...MORE_PAGES].map((link) => (
          <a class={textLinkLook({ tone: "ink", quiet: true, className: "item" })} href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="legal">
      <span class="quiet">{`${footer.copyright} ${String(year)} ${footer.entity}`}</span>
      {legal.links.map((link) => (
        <a class={textLinkLook({ tone: "ink", quiet: true, className: "item small" })} href={link.href}>
          {link.label}
        </a>
      ))}
      <Social />
    </div>
  </div>
</footer>

<style>
  .slim {
    margin-top: var(--section-gap);
    background: var(--site-navy);
    color: var(--site-on-navy);
  }
  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sp-36) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
  }
  .top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-12);
  }
  .home {
    display: flex;
  }
  .pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-20);
  }
  .item {
    font-size: var(--fs-16);
    color: var(--site-on-navy);
  }
  /* The company's name on the line its links' words sit on, though each link is a thumb's height to tap. */
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--sp-16);
    padding-top: var(--sp-8);
    border-top: var(--hairline) solid var(--site-navy-rule);
    font-size: var(--fs-13);
  }
  .small {
    font-size: var(--fs-13);
  }
  .quiet {
    color: var(--site-on-navy-muted);
  }
  /* The company's pages elsewhere, at the legal line's end. */
  .legal > :global(.social) {
    margin-left: auto;
  }

  @media (min-width: 761px) {
    .inner {
      padding: var(--sp-48) var(--gutter) var(--sp-40);
      gap: var(--sp-20);
    }
    .top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .pages {
      gap: 0 var(--sp-28);
    }
    .legal {
      gap: 0 var(--sp-24);
      padding-top: var(--sp-12);
      font-size: var(--fs-14);
    }
    .small {
      font-size: var(--fs-14);
    }
    .flow {
      display: none;
    }
  }
</style>
