---
// The bar fixed to the foot of a phone's home page, white under a hairline (ADR 0263): WhatsApp beside the free
// consultation, the one filled button on the screen while it shows. A section's own filled button carries
// data-filled, which the script beneath watches for. On a wider screen the header's own button books.
import { stickyBar, whatsapp } from "../content/site.ts";
import { isShown } from "../lib/build.ts";
import { whatsappChat } from "@maneman/web-kit/whatsapp";
import Icon from "./Icon.astro";
import { buttonLook } from "@maneman/ui/Button";
import { iconButtonLook } from "@maneman/ui/IconButton";
---

<nav class="bar" aria-label={stickyBar.label} data-sticky-bar>
  <div class="row">
    {isShown(whatsapp) && (
      <a
        class={iconButtonLook("whatsapp", true)}
        href={whatsappChat(whatsapp.number)}
        aria-label={stickyBar.whatsappLabel}
      >
        <Icon name="whatsapp" size="md" />
      </a>
    )}
    <a class={buttonLook({ variant: "primary", size: "action", className: "book" })} href="/book">
      {stickyBar.book}
    </a>
  </div>
</nav>
<script is:inline>
  // Up once the hero has scrolled away, and down while a section's own filled button is on the screen, so one filled
  // button shows at a time (ADR 0266). Where scripts do not run, it is there from the start.
  (() => {
    const bar = document.currentScript.previousElementSibling;
    const hero = document.querySelector('[data-section="hero"]');
    if (bar === null || hero === null || !("IntersectionObserver" in window)) return;
    const filled = new Set();
    let heroGone = false;
    bar.dataset.waiting = "";
    const watch = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === hero) heroGone = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        else if (entry.isIntersecting) filled.add(entry.target);
        else filled.delete(entry.target);
      }
      if (heroGone && filled.size === 0) delete bar.dataset.waiting;
      else bar.dataset.waiting = "";
    });
    watch.observe(hero);
    for (const button of document.querySelectorAll("main [data-filled]")) watch.observe(button);
  })();
</script>

<style>
  /* Only a phone's home page has the bar, and nothing the keyboard reaches may sit under it. */
  @media (max-width: 760px) {
    :global(html) {
      scroll-padding-bottom: var(--bar-h);
    }
    /* Only while it is up: hidden while the hero shows, it leaves the cookie bar at the window's foot. */
    :global(body:has([data-sticky-bar]:not([data-waiting]))) {
      --foot-bar-h: var(--bar-h);
    }
  }
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-bar);
    background: var(--site-ground);
    border-top: var(--hairline) solid var(--site-line);
    padding: var(--site-bar-pad-top) var(--sp-16) calc(var(--site-bar-pad-bottom) + var(--site-safe-bottom));
    transition:
      transform var(--duration-quick) var(--ease-house),
      visibility var(--duration-quick) var(--ease-house);
  }
  .bar[data-waiting] {
    transform: translateY(100%);
    visibility: hidden;
  }
  .row {
    width: 100%;
    max-width: var(--measure-short);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--sp-8);
  }
  .whatsapp {
    --icon-button-size: var(--site-button-h);
    border-color: var(--site-navy);
    color: var(--site-navy);
  }
  .book {
    flex: 1;
    min-height: var(--site-button-h);
    font-size: var(--site-fs-button);
  }
  @media (min-width: 761px) {
    .bar {
      display: none;
    }
  }
</style>
