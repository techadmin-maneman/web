---
// The bar fixed to the bottom of the home page, at every width, as the design draws it. Its buttons keep to a phone's
// width, so on a wide screen the booking button is a button rather than a band across the page.
import { stickyBar, whatsapp } from "../content/site.ts";
import { isShown } from "../lib/build.ts";
import { whatsappChat } from "@maneman/web-kit/whatsapp";
import Icon from "./Icon.astro";
import { buttonLook } from "@maneman/ui/Button";
import { iconButtonLook } from "@maneman/ui/IconButton";
---

<nav class="bar on-ink" aria-label={stickyBar.label}>
  <div class="row">
    {isShown(whatsapp) && (
      <a
        class={iconButtonLook("whatsapp", true)}
        href={whatsappChat(whatsapp.number)}
        aria-label={stickyBar.whatsappLabel}
      >
        <Icon name="whatsapp" size={22} />
      </a>
    )}
    <a class={buttonLook({ variant: "light", size: "control", className: "book" })} href="/book">
      {stickyBar.book}
    </a>
  </div>
</nav>

<style>
  /* Only the home page has the bar, and nothing the keyboard reaches may sit under it. */
  :global(html) {
    scroll-padding-bottom: var(--bar-reserve);
  }
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    height: var(--bar-h);
    background: var(--ink-deep);
    border-top: var(--hairline) solid var(--ink-rule);
    display: flex;
    align-items: center;
    padding: 0 var(--sp-16);
  }
  .row {
    width: 100%;
    max-width: var(--measure-short);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--sp-12);
  }
  .whatsapp {
    --icon-button-size: var(--btn-md);
  }
  .book {
    flex: 1;
  }
</style>
