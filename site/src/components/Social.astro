---
// The company's pages elsewhere, as icons a thumb can tap, at the end of the footer's last line, where global sites put
// them (site/src/content/site/contact.ts).
import { socialLinks } from "../content/site.ts";
import { isShown } from "../lib/build.ts";
import { textLinkLook } from "@maneman/ui/TextLink";
import Icon from "./Icon.astro";
---

{isShown(socialLinks) && (
  <ul class="social">
    {socialLinks.links.map((link) => (
      <li>
        <a
          class={textLinkLook({ tone: "ink", quiet: true, className: "icon" })}
          href={link.href}
          aria-label={link.label}
          rel="noopener"
        >
          <Icon name={link.icon} size="lg" />
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .social {
    display: flex;
    gap: var(--sp-8);
    /* The last icon's edge, not its tap's, meets the line's end; on a phone, where the row starts its own line, the
       first icon's meets the column's. */
    margin: 0 calc(-1 * var(--sp-8)) 0 calc((var(--sp-24) - var(--tap)) / 2);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 761px) {
    .social {
      margin-left: 0;
    }
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    color: var(--ink-muted);
  }
  .icon:hover {
    color: var(--site-on-navy);
  }
</style>
