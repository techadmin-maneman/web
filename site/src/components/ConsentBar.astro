---
// The bar that asks for consent to the ad and measurement tags (site/src/lib/analytics.ts), at the foot of every page
// until the visitor answers, and again when they pick Cookie choices in a footer. Switched on and off by
// CONSENT_BAR_SHOWN; hidden until the page's script finds no answer kept, so a visitor who answered never sees it flash.
import { buttonLook } from "@maneman/ui/Button";
import { textLinkLook } from "@maneman/ui/TextLink";
import { consentBar as words } from "../content/site.ts";
---

<div class="bar on-ink" data-consent-bar role="region" aria-label={words.label} hidden>
  <p class="text">
    {words.text}{" "}
    <a class={textLinkLook({ tone: "ink", inline: true })} href="/privacy">
      {words.privacy}
    </a>
  </p>
  <div class="actions">
    <button type="button" class={buttonLook({ variant: "light", size: "small" })} data-consent="granted">
      {words.accept}
    </button>
    <button type="button" class={buttonLook({ variant: "outlineOnInk", size: "small" })} data-consent="denied">
      {words.decline}
    </button>
  </div>
</div>

<script>
  import { answerConsent, consentAnswer } from "../lib/analytics.ts";
  import { reportDeclined } from "../lib/visit.ts";

  const bar = document.querySelector<HTMLElement>("[data-consent-bar]");
  const root = document.documentElement;
  // While it asks, the page keeps the bar's height clear at its foot, so a page that ends in a form can still bring
  // the form's last button above it (--consent-reserve, site/src/styles/tokens-site.css).
  const keepClear = new ResizeObserver(() => {
    if (bar === null) return;
    // The bar, what holds it above the page's foot, and as much again above it.
    const above = parseFloat(getComputedStyle(bar).bottom);
    root.style.setProperty("--consent-reserve", `${String(bar.offsetHeight + 2 * above)}px`);
  });

  /** The footer button that brought the bar back, given the focus again once the visitor answers. */
  let opener: HTMLElement | null = null;

  function ask(): void {
    if (bar === null || !bar.hidden) return;
    bar.hidden = false;
    // Said on the page too, so a button pinned at a phone's foot can wait in its place instead (islands/invite).
    root.dataset.consentAsking = "";
    keepClear.observe(bar);
  }

  if (bar !== null) {
    for (const button of bar.querySelectorAll<HTMLButtonElement>("[data-consent]")) {
      button.addEventListener("click", () => {
        const answer = button.dataset.consent === "granted" ? "granted" : "denied";
        answerConsent(answer);
        // The API keeps nothing of this browser's for Meta once it is declined, what came before included.
        if (answer === "denied") void reportDeclined();
        bar.hidden = true;
        keepClear.disconnect();
        root.style.removeProperty("--consent-reserve");
        delete root.dataset.consentAsking;
        opener?.focus();
        opener = null;
      });
    }
    if (consentAnswer() === null) ask();
  }

  // The footers' Cookie choices: the bar again, the answer kept holding until another is picked, so a visitor may
  // decline as easily as they agreed, and one who declined is never taken to agree by asking (Privacy Policy, 7).
  // The bar opens over the footer's foot, so the focus moves into it, where a screen reader hears it, and comes back.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-cookie-choices]")) {
    button.addEventListener("click", () => {
      ask();
      opener = button;
      bar?.querySelector<HTMLButtonElement>("[data-consent='granted']")?.focus();
    });
  }
</script>

<style>
  .bar {
    position: fixed;
    /* Above the home page's foot bar on a phone, which would cover its buttons. */
    inset: auto var(--gutter) calc(var(--foot-bar-h) + var(--sp-16));
    z-index: var(--z-consent);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-16);
    align-items: center;
    justify-content: space-between;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sp-16) var(--sp-20);
    background: var(--ink-deep);
    border: var(--hairline) solid var(--ink-rule);
  }
  .bar[hidden] {
    display: none;
  }
  .text {
    flex: 1 1 auto;
    margin: 0;
    font-size: var(--fs-14);
    line-height: var(--lh-160);
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    gap: var(--sp-12);
  }
</style>
