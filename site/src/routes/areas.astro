---
// Areas we cover (src/content/guides.ts), at /areas, and a link to each city's own page. The build adds the route only
// once its wording is shown (site/astro.config.ts): for staging under the design's "Placeholder" tag until it is
// approved, for production then.
import { buttonLook } from "@maneman/ui/Button";
import LinkRows from "../components/LinkRows.astro";
import { areasPage, cityPage, guidesPage } from "../content/guides.ts";
import TextPage from "../layouts/TextPage.astro";
import { isShown } from "../lib/build.ts";
import { citySlug } from "../lib/cities.ts";
import { SERVED_CITIES } from "../lib/served-cities.ts";
import { breadcrumbs } from "../lib/structured-data.ts";
import { fill } from "../lib/text.ts";

const trail = [
  { name: guidesPage.home, path: "/" },
  { name: areasPage.title, path: "/areas" },
];
---

<TextPage
  pageTitle={areasPage.pageTitle}
  description={areasPage.description}
  title={areasPage.title}
  publish={areasPage.publish}
  short
  structuredData={[breadcrumbs(trail)]}
>
  <p slot="lead" class="page-lede" data-cities={areasPage.cities}>
    {areasPage.lead}
  </p>
  <p class="streets">{areasPage.streets}</p>
  <p class="next">{areasPage.next}</p>
  <a class={buttonLook({ variant: "primary", size: "action", className: "book" })} href="/book">
    {areasPage.check}
  </a>
  {isShown(cityPage) && (
    <nav class="cities" aria-labelledby="city-pages">
      <h2 id="city-pages" class="list-head">
        {areasPage.cityPages}
      </h2>
      <LinkRows
        look="cities"
        rows={SERVED_CITIES.map((city) => ({
          href: `/areas/${citySlug(city)}`,
          title: fill(cityPage.title, { city }),
          city,
        }))}
      />
    </nav>
  )}
</TextPage>

<style>
  .streets {
    margin: var(--site-gap-near) 0 0;
  }
  .next {
    margin: var(--site-gap-page-lede) 0 0;
  }
  .book {
    margin-top: var(--sp-24);
  }
  .cities {
    margin-top: var(--sp-40);
  }
  .cities .list-head {
    margin-top: 0;
  }
  /* Across a phone; on a laptop, as wide as its words. */
  @media (min-width: 761px) {
    .book {
      width: fit-content;
    }
  }
</style>
