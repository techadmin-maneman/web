# .env.staging-access: A Cloudflare Access service token for staging's hosts, for the scripts that call staging's API.
# Copy to .env.staging-access (git ignores it) and fill in the values; docs/env-files.md says where each comes from.
# Never commit a value, and never print one.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
STAGING_TEST_MOBILE=
ERASURE_SECRET=
