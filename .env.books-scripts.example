# .env.books-scripts: Zoho Books with the scripts' own refresh token, for the Books checks, proofs and staging records.
# Copy to .env.books-scripts (git ignores it) and fill in the values; docs/env-files.md says where each comes from.
# Never commit a value, and never print one.
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_SCRIPTS_REFRESH_TOKEN=
ZOHO_BOOKS_ACCOUNTS_HOST=
ZOHO_BOOKS_API_HOST=
ZOHO_BOOKS_ORG_ID=
