{
  "printWidth": 120,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.jsonc", "*.json"],
      "options": {
        "trailingComma": "none"
      }
    },
    {
      "files": ["*.astro"],
      "options": {
        "parser": "astro"
      }
    }
  ],
  "plugins": ["prettier-plugin-astro"]
}
